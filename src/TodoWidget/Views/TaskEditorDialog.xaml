<Window x:Class="TodoWidget.Views.TaskEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:TodoWidget.Converters"
        mc:Ignorable="d"
        Title="{Binding DialogTitle}"
        Width="460"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False">

    <Window.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:BooleanToVisibilityConverter x:Key="InvBoolToVis" Invert="True" />
        <converters:PriorityToBrushConverter x:Key="PriorityToBrush" />
    </Window.Resources>

    
    <Border Margin="16"
            CornerRadius="16"
            Background="#1E1E2E"
            BorderBrush="#45475A"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24"
                              Color="#000000"
                              Opacity="0.55"
                              ShadowDepth="8" />
        </Border.Effect>

        <Grid Margin="20">
            <Grid.RowDefinitions>
                
                <RowDefinition Height="Auto" />
                
                <RowDefinition Height="*" />
                
                <RowDefinition Height="Auto" />
                
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            
            <Grid Grid.Row="0" Margin="0,0,0,16" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="📝" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding DialogTitle}"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="#CDD6F4"
                               VerticalAlignment="Center" />
                </StackPanel>

                
                <Button Grid.Column="1"
                        Width="28"
                        Height="28"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="CloseButton_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="CloseBorder" CornerRadius="6" Background="Transparent">
                                <TextBlock Text="✕"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="#A6ADC8"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="CloseBorder" Property="Background" Value="#3D2029" />
                                    <Setter Property="Foreground" Value="#F38BA8" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            
            <StackPanel Grid.Row="1">
                
                <TextBlock Text="Task Title *"
                           FontSize="12"
                           FontWeight="Medium"
                           Foreground="#A6ADC8"
                           Margin="0,0,0,6" />
                <TextBox x:Name="TitleInput"
                         Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                         FontSize="14"
                         Padding="10,8"
                         Background="#181825"
                         Foreground="#CDD6F4"
                         CaretBrush="#3B82F6"
                         BorderBrush="#45475A"
                         BorderThickness="1"
                         Margin="0,0,0,14">
                    <TextBox.Resources>
                        <Style TargetType="{x:Type Border}">
                            <Setter Property="CornerRadius" Value="8" />
                        </Style>
                    </TextBox.Resources>
                </TextBox>

                
                <TextBlock Text="Description (Optional)"
                           FontSize="12"
                           FontWeight="Medium"
                           Foreground="#A6ADC8"
                           Margin="0,0,0,6" />
                <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                         FontSize="13"
                         Height="75"
                         Padding="10,8"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         Background="#181825"
                         Foreground="#CDD6F4"
                         CaretBrush="#3B82F6"
                         BorderBrush="#45475A"
                         BorderThickness="1"
                         Margin="0,0,0,14">
                    <TextBox.Resources>
                        <Style TargetType="{x:Type Border}">
                            <Setter Property="CornerRadius" Value="8" />
                        </Style>
                    </TextBox.Resources>
                </TextBox>

                
                <Border Background="#181825"
                        CornerRadius="8"
                        BorderBrush="#313244"
                        BorderThickness="1"
                        Padding="12,10"
                        Margin="0,0,0,14">
                    <StackPanel>
                        <CheckBox Content="Recurring Schedule (repeat on specific days)"
                                  IsChecked="{Binding IsRecurring}"
                                  FontWeight="SemiBold"
                                  Foreground="#89B4FA"
                                  Margin="0,0,0,8" />

                        <!-- Day Selectors (MWF, TTS, or any custom combination) -->
                        <StackPanel Visibility="{Binding IsRecurring, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Select Days:" FontSize="11.5" Foreground="#A6ADC8" Margin="0,0,0,6" />
                            <WrapPanel Margin="0,0,0,10">
                                <CheckBox Content="Mon" IsChecked="{Binding RepeatMon}" Foreground="#CDD6F4" Margin="0,0,10,6" />
                                <CheckBox Content="Tue" IsChecked="{Binding RepeatTue}" Foreground="#CDD6F4" Margin="0,0,10,6" />
                                <CheckBox Content="Wed" IsChecked="{Binding RepeatWed}" Foreground="#CDD6F4" Margin="0,0,10,6" />
                                <CheckBox Content="Thu" IsChecked="{Binding RepeatThu}" Foreground="#CDD6F4" Margin="0,0,10,6" />
                                <CheckBox Content="Fri" IsChecked="{Binding RepeatFri}" Foreground="#CDD6F4" Margin="0,0,10,6" />
                                <CheckBox Content="Sat" IsChecked="{Binding RepeatSat}" Foreground="#CDD6F4" Margin="0,0,10,6" />
                                <CheckBox Content="Sun" IsChecked="{Binding RepeatSun}" Foreground="#CDD6F4" Margin="0,0,10,6" />
                            </WrapPanel>

                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Start Time" FontSize="11" Foreground="#A6ADC8" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding StartTime, StringFormat=hh\\:mm}" Background="#11111B" Foreground="#CDD6F4" BorderBrush="#45475A" Padding="6,4" ToolTip="Format: HH:mm (e.g. 09:00)" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="End Time" FontSize="11" Foreground="#A6ADC8" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding EndTime, StringFormat=hh\\:mm}" Background="#11111B" Foreground="#CDD6F4" BorderBrush="#45475A" Padding="6,4" ToolTip="Format: HH:mm (e.g. 11:00)" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- One-time Due Date and Time (when not recurring) -->
                <Grid Margin="0,0,0,14" Visibility="{Binding IsRecurring, Converter={StaticResource InvBoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Due Date"
                                   FontSize="12"
                                   FontWeight="Medium"
                                   Foreground="#A6ADC8"
                                   Margin="0,0,0,6" />
                        <DatePicker SelectedDate="{Binding DueDate}"
                                    Height="36"
                                    Background="#181825"
                                    Foreground="#CDD6F4"
                                    BorderBrush="#45475A" />
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Due Time"
                                   FontSize="12"
                                   FontWeight="Medium"
                                   Foreground="#A6ADC8"
                                   Margin="0,0,0,6" />
                        <ComboBox x:Name="TimeComboBox"
                                  Height="36"
                                  Background="#181825"
                                  Foreground="#CDD6F4"
                                  BorderBrush="#45475A"
                                  SelectionChanged="TimeComboBox_SelectionChanged" />
                    </StackPanel>
                </Grid>

                
                <TextBlock Text="Priority"
                           FontSize="12"
                           FontWeight="Medium"
                           Foreground="#A6ADC8"
                           Margin="0,0,0,6" />
                <ComboBox ItemsSource="{Binding AvailablePriorities}"
                          SelectedItem="{Binding Priority}"
                          Height="36"
                          Background="#181825"
                          Foreground="#CDD6F4"
                          BorderBrush="#45475A"
                          Margin="0,0,0,10">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8"
                                         Height="8"
                                         Margin="0,0,8,0"
                                         VerticalAlignment="Center"
                                         Fill="{Binding Converter={StaticResource PriorityToBrush}}" />
                                <TextBlock Text="{Binding}" Foreground="#CDD6F4" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <!-- Voice Note Section -->
                <TextBlock Text="Voice Note"
                           FontSize="12"
                           FontWeight="Medium"
                           Foreground="#A6ADC8"
                           Margin="0,0,0,6" />

                <Border Background="#181825"
                        CornerRadius="8"
                        BorderBrush="#313244"
                        BorderThickness="1"
                        Padding="12,10"
                        Margin="0,0,0,8">
                    <Grid>
                        <!-- State 1: No Voice Note recorded and not currently recording -->
                        <Grid Visibility="{Binding HasVoiceNote, Converter={StaticResource InvBoolToVis}}">
                            <!-- Show when not recording -->
                            <StackPanel Orientation="Horizontal" Visibility="{Binding IsRecordingVoiceNote, Converter={StaticResource InvBoolToVis}}">
                                <Button Content="🎙️ Record Voice Note"
                                        Padding="12,6"
                                        FontSize="12"
                                        FontWeight="Medium"
                                        Background="#25263B"
                                        Foreground="#CDD6F4"
                                        BorderBrush="#45475A"
                                        BorderThickness="1"
                                        Cursor="Hand"
                                        Command="{Binding StartRecordVoiceNoteCommand}">
                                    <Button.Resources>
                                        <Style TargetType="{x:Type Border}">
                                            <Setter Property="CornerRadius" Value="6" />
                                        </Style>
                                    </Button.Resources>
                                </Button>
                                <TextBlock Text="Optional audio note"
                                           FontSize="11.5"
                                           Foreground="#6C7086"
                                           VerticalAlignment="Center"
                                           Margin="10,0,0,0" />
                            </StackPanel>

                            <!-- Show while recording -->
                            <Grid Visibility="{Binding IsRecordingVoiceNote, Converter={StaticResource BoolToVis}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="6" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="●" FontSize="16" Foreground="#EF4444" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Recording..." FontSize="12.5" FontWeight="SemiBold" Foreground="#EF4444" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding RecordingDurationText}" FontSize="12.5" FontWeight="Bold" Foreground="#CDD6F4" Margin="8,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>

                                <Button Grid.Column="2"
                                        Content="■ Stop"
                                        Padding="10,5"
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        Background="#EF4444"
                                        Foreground="#FFFFFF"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        Command="{Binding StopRecordVoiceNoteCommand}">
                                    <Button.Resources>
                                        <Style TargetType="{x:Type Border}">
                                            <Setter Property="CornerRadius" Value="6" />
                                        </Style>
                                    </Button.Resources>
                                </Button>

                                <Button Grid.Column="4"
                                        Content="Cancel"
                                        Padding="10,5"
                                        FontSize="12"
                                        Background="#313244"
                                        Foreground="#A6ADC8"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        Command="{Binding CancelRecordVoiceNoteCommand}">
                                    <Button.Resources>
                                        <Style TargetType="{x:Type Border}">
                                            <Setter Property="CornerRadius" Value="6" />
                                        </Style>
                                    </Button.Resources>
                                </Button>
                            </Grid>
                        </Grid>

                        <!-- State 2: Voice Note exists -->
                        <Grid Visibility="{Binding HasVoiceNote, Converter={StaticResource BoolToVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Play / Pause Button -->
                            <Button Grid.Column="0"
                                    Width="30"
                                    Height="30"
                                    Background="#3B82F6"
                                    Foreground="#FFFFFF"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Command="{Binding PlayVoiceNoteCommand}"
                                    Margin="0,0,10,0">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border CornerRadius="15" Background="{TemplateBinding Background}">
                                            <TextBlock Text="▶"
                                                       FontSize="11"
                                                       FontWeight="Bold"
                                                       Foreground="#FFFFFF"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="▶" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsPlayingVoiceNote}" Value="True">
                                                                <Setter Property="Text" Value="⏸" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <!-- Voice Note info & duration -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Voice Note" FontSize="12.5" FontWeight="SemiBold" Foreground="#CDD6F4" />
                                    <TextBlock Text="{Binding VoiceNoteDurationText, StringFormat=' ({0})'}"
                                               FontSize="11.5"
                                               Foreground="#89B4FA"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="Click play to listen" FontSize="10.5" Foreground="#6C7086" />
                            </StackPanel>

                            <!-- Delete / Re-record Button -->
                            <Button Grid.Column="3"
                                    Content="🗑️ Delete"
                                    Padding="10,5"
                                    FontSize="11.5"
                                    Background="#3D2029"
                                    Foreground="#F38BA8"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Command="{Binding DeleteVoiceNoteCommand}">
                                <Button.Resources>
                                    <Style TargetType="{x:Type Border}">
                                        <Setter Property="CornerRadius" Value="6" />
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </Grid>
                    </Grid>
                </Border>
            </StackPanel>

            
            <TextBlock Grid.Row="2"
                       Text="{Binding ErrorMessage}"
                       Foreground="#F38BA8"
                       FontSize="12"
                       FontWeight="Medium"
                       Margin="0,4,0,10"
                       Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" />

            
            <Grid Grid.Row="3" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                
                <Button Grid.Column="1"
                        Content="Cancel"
                        Width="90"
                        Height="36"
                        FontSize="13"
                        FontWeight="Medium"
                        Background="#313244"
                        Foreground="#CDD6F4"
                        BorderThickness="0"
                        Cursor="Hand"
                        Command="{Binding CancelCommand}">
                    <Button.Resources>
                        <Style TargetType="{x:Type Border}">
                            <Setter Property="CornerRadius" Value="8" />
                        </Style>
                    </Button.Resources>
                </Button>

                
                <Button Grid.Column="3"
                        Content="Save"
                        Width="100"
                        Height="36"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Background="#3B82F6"
                        Foreground="#FFFFFF"
                        BorderThickness="0"
                        Cursor="Hand"
                        Command="{Binding SaveCommand}">
                    <Button.Resources>
                        <Style TargetType="{x:Type Border}">
                            <Setter Property="CornerRadius" Value="8" />
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
