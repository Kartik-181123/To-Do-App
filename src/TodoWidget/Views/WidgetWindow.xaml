<Window x:Class="TodoWidget.Views.WidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:TodoWidget.Views.Controls"
        xmlns:converters="clr-namespace:TodoWidget.Converters"
        mc:Ignorable="d"
        Title="To-Do"
        Width="250"
        Height="250"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:BooleanToVisibilityConverter x:Key="InvBoolToVis" Invert="True" />
        <converters:PriorityToBrushConverter x:Key="PriorityToBrush" />

        <Style x:Key="HeaderIconButton" TargetType="Button">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder" CornerRadius="6" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#313244" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    
    <Border Margin="8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="14"
                              Color="#000000"
                              Opacity="0.4"
                              ShadowDepth="4" />
        </Border.Effect>

        <Border x:Name="MainWidgetBorder"
                CornerRadius="14"
                Background="#1E1E2E"
                BorderBrush="#313244"
                BorderThickness="1">

            <Grid>
                <Grid.RowDefinitions>
                    <!-- Header -->
                    <RowDefinition Height="Auto" />
                    <!-- Task List Area -->
                    <RowDefinition Height="*" />
                    <!-- Minimal Quick-Add Bar -->
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Minimal Header -->
                <Border Grid.Row="0"
                        x:Name="HeaderBar"
                        Background="#181825"
                        CornerRadius="13,13,0,0"
                        Padding="10,6"
                        BorderBrush="#25263B"
                        BorderThickness="0,0,0,1"
                        MouseLeftButtonDown="HeaderBar_MouseLeftButtonDown">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Title & Drag Handle -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="⋮⋮"
                                       FontSize="12"
                                       Foreground="#585B70"
                                       Margin="0,0,6,0"
                                       VerticalAlignment="Center"
                                       Cursor="SizeAll" />
                            <TextBlock Text="To-Do"
                                       FontSize="12.5"
                                       FontWeight="SemiBold"
                                       Foreground="#CDD6F4"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- Streak Counter -->
                        <controls:StreakBadge Grid.Column="1"
                                              StreakCount="{Binding CurrentStreak}"
                                              Margin="0,0,6,0"
                                              VerticalAlignment="Center" />

                        <!-- Window Buttons -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource HeaderIconButton}"
                                    ToolTip="Open Dashboard"
                                    Width="22"
                                    Height="22"
                                    Command="{Binding OpenDashboardCommand}"
                                    Margin="0,0,2,0">
                                <TextBlock Text="⚙" FontSize="12" Foreground="#A6ADC8" />
                            </Button>

                            <Button Style="{StaticResource HeaderIconButton}"
                                    ToolTip="Hide Widget"
                                    Width="22"
                                    Height="22"
                                    Click="CloseButton_Click">
                                <TextBlock Text="✕" FontSize="11" Foreground="#A6ADC8" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Tasks Area -->
                <Grid Grid.Row="1" Margin="6,4,6,4">
                    <!-- Empty State -->
                    <Border Visibility="{Binding HasTasks, Converter={StaticResource InvBoolToVis}}"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Padding="12">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="🎉"
                                       FontSize="22"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,4" />
                            <TextBlock Text="All caught up!"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="#CDD6F4"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="Add a task below"
                                       FontSize="10.5"
                                       Foreground="#6C7086"
                                       HorizontalAlignment="Center"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Scrollable Tasks -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Visibility="{Binding HasTasks, Converter={StaticResource BoolToVis}}">
                        <ItemsControl ItemsSource="{Binding Tasks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <controls:TaskItemControl Task="{Binding}"
                                                              CompleteCommand="{Binding DataContext.CompleteTaskCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                              DeleteCommand="{Binding DataContext.DeleteTaskCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                              VoiceNoteCommand="{Binding DataContext.ToggleVoiceNoteCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <!-- Minimal Compact Quick-Add Bar -->
                <Border Grid.Row="2"
                        Background="#181825"
                        CornerRadius="0,0,13,13"
                        Padding="6,5"
                        BorderBrush="#25263B"
                        BorderThickness="0,1,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Background="#1E1E2E"
                                CornerRadius="6"
                                BorderBrush="#313244"
                                BorderThickness="1"
                                Margin="0,0,4,0">
                            <TextBox x:Name="QuickAddInput"
                                     Text="{Binding NewTaskTitle, UpdateSourceTrigger=PropertyChanged}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Padding="6,4"
                                     FontSize="11.5"
                                     Foreground="#CDD6F4"
                                     CaretBrush="#3B82F6"
                                     KeyDown="QuickAddInput_KeyDown">
                                <TextBox.Style>
                                    <Style TargetType="TextBox">
                                        <Style.Triggers>
                                            <Trigger Property="Text" Value="">
                                                <Setter Property="Background">
                                                    <Setter.Value>
                                                        <VisualBrush AlignmentX="Left" Stretch="None">
                                                            <VisualBrush.Visual>
                                                                <TextBlock Text="+ Quick add task..."
                                                                           Foreground="#585B70"
                                                                           FontSize="11"
                                                                           Padding="7,4" />
                                                            </VisualBrush.Visual>
                                                        </VisualBrush>
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                        </Border>

                        <Button Grid.Column="1"
                                Width="26"
                                Height="26"
                                Background="#3B82F6"
                                Foreground="#FFFFFF"
                                BorderThickness="0"
                                Cursor="Hand"
                                ToolTip="Add Task (Enter)"
                                Command="{Binding AddQuickTaskCommand}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="AddBtnBorder" CornerRadius="6" Background="{TemplateBinding Background}">
                                        <TextBlock Text="+"
                                                   FontSize="16"
                                                   FontWeight="Bold"
                                                   Foreground="#FFFFFF"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Margin="0,-2,0,0" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="AddBtnBorder" Property="Background" Value="#2563EB" />
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="AddBtnBorder" Property="Opacity" Value="0.4" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Border>
</Window>
