<Window x:Class="TodoWidget.Views.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:TodoWidget.Converters"
        xmlns:models="clr-namespace:TodoWidget.Models"
        mc:Ignorable="d"
        Title="To-Do - Task &amp; Settings Manager"
        Width="960"
        Height="680"
        MinWidth="860"
        MinHeight="580"
        WindowStartupLocation="CenterScreen"
        Background="#181825"
        Foreground="#CDD6F4">

    <Window.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:BooleanToVisibilityConverter x:Key="InvBoolToVis" Invert="True" />
        <converters:StringToVisibilityConverter x:Key="StringToVis" />
        <converters:InverseBooleanConverter x:Key="InvBool" />
        <converters:PriorityToBrushConverter x:Key="PriorityToBrush" />
        <converters:DueDateFormatterConverter x:Key="DueDateFormatter" />
        <converters:StatusToBrushConverter x:Key="StatusToBrush" />
        <converters:StatusToStrikethroughConverter x:Key="StatusToStrikethrough" />
        <converters:StatusToOpacityConverter x:Key="StatusToOpacity" />

        
        <Style x:Key="SidebarNavButton" TargetType="RadioButton">
            <Setter Property="Height" Value="42" />
            <Setter Property="Margin" Value="0,2,0,2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#A6ADC8" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="NavBorder"
                                CornerRadius="8"
                                Background="{TemplateBinding Background}"
                                Padding="12,0">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavBorder" Property="Background" Value="#1E1E2E" />
                                <Setter Property="Foreground" Value="#CDD6F4" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="NavBorder" Property="Background" Value="#313244" />
                                <Setter Property="Foreground" Value="#89B4FA" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        
        <Style x:Key="CardPanel" TargetType="Border">
            <Setter Property="Background" Value="#1E1E2E" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="BorderBrush" Value="#313244" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="18" />
            <Setter Property="Margin" Value="0,0,0,16" />
        </Style>

        
        <Style x:Key="StatCard" TargetType="Border">
            <Setter Property="Background" Value="#1E1E2E" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="BorderBrush" Value="#313244" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="6" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            
            <ColumnDefinition Width="220" />
            
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        
        <Border Grid.Column="0"
                Background="#11111B"
                BorderBrush="#25263B"
                BorderThickness="0,0,1,0"
                Padding="16,20">
            <Grid>
                <Grid.RowDefinitions>
                    
                    <RowDefinition Height="Auto" />
                    
                    <RowDefinition Height="*" />
                    
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                
                <StackPanel Grid.Row="0" Margin="0,0,0,24">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="⚡" FontSize="20" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="To-Do"
                                   FontSize="17"
                                   FontWeight="Bold"
                                   Foreground="#CDD6F4"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="Desktop Companion"
                               FontSize="11.5"
                               Foreground="#6C7086"
                               Margin="28,0,0,0" />
                </StackPanel>

                
                <StackPanel Grid.Row="1">
                    <RadioButton Style="{StaticResource SidebarNavButton}"
                                 GroupName="NavTabs"
                                 IsChecked="{Binding SelectedTabIndex, Converter={x:Null}, Mode=OneWay}"
                                 Checked="NavTasks_Checked"
                                 x:Name="NavTasksRadio">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📋" FontSize="15" Margin="0,0,10,0" VerticalAlignment="Center" />
                            <TextBlock Text="Tasks" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton Style="{StaticResource SidebarNavButton}"
                                 GroupName="NavTabs"
                                 Checked="NavStats_Checked"
                                 x:Name="NavStatsRadio">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📊" FontSize="15" Margin="0,0,10,0" VerticalAlignment="Center" />
                            <TextBlock Text="Stats &amp; Streaks" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton Style="{StaticResource SidebarNavButton}"
                                 GroupName="NavTabs"
                                 Checked="NavSettings_Checked"
                                 x:Name="NavSettingsRadio">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚙️" FontSize="15" Margin="0,0,10,0" VerticalAlignment="Center" />
                            <TextBlock Text="Settings" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>

                
                <Border Grid.Row="2"
                        Background="#1E1E2E"
                        CornerRadius="10"
                        Padding="12,10"
                        BorderBrush="#313244"
                        BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Current Streak"
                                   FontSize="11"
                                   FontWeight="Medium"
                                   Foreground="#6C7086" />
                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                            <TextBlock Text="🔥" FontSize="16" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding StreakCount}"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="#FFAA44"
                                       VerticalAlignment="Center" />
                            <TextBlock Text=" Days Active"
                                       FontSize="12"
                                       Foreground="#A6ADC8"
                                       VerticalAlignment="Center"
                                       Margin="4,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        
        <Grid Grid.Column="1" Background="#181825">

            
            <Grid x:Name="TasksTabView" Visibility="Visible" Margin="24,20">
                <Grid.RowDefinitions>
                    
                    <RowDefinition Height="Auto" />
                    
                    <RowDefinition Height="Auto" />
                    
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                
                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Task Overview"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="#CDD6F4" />
                        <TextBlock Text="Manage, organize, and prioritize your daily schedule"
                                   FontSize="12.5"
                                   Foreground="#6C7086"
                                   Margin="0,2,0,0" />
                    </StackPanel>

                    
                    <Button Grid.Column="1"
                            Content="+ New Task"
                            Height="38"
                            Padding="16,0"
                            FontSize="13.5"
                            FontWeight="SemiBold"
                            Background="#3B82F6"
                            Foreground="#FFFFFF"
                            BorderThickness="0"
                            Cursor="Hand"
                            Command="{Binding AddTaskCommand}">
                        <Button.Resources>
                            <Style TargetType="{x:Type Border}">
                                <Setter Property="CornerRadius" Value="8" />
                            </Style>
                        </Button.Resources>
                    </Button>
                </Grid>

                
                <Grid Grid.Row="1" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        
                        <ColumnDefinition Width="*" />
                        
                        <ColumnDefinition Width="150" />
                        
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    
                    <Border Grid.Column="0"
                            Background="#1E1E2E"
                            CornerRadius="8"
                            BorderBrush="#313244"
                            BorderThickness="1"
                            Margin="0,0,10,0">
                        <Grid>
                            <TextBlock Text="🔍 Search tasks..."
                                       Foreground="#6C7086"
                                       FontSize="12.5"
                                       Margin="12,9,0,0"
                                       IsHitTestVisible="False"
                                       Visibility="{Binding FilterText, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding FilterText}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBox Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                                     Background="Transparent"
                                     Foreground="#CDD6F4"
                                     CaretBrush="#3B82F6"
                                     BorderThickness="0"
                                     Padding="12,8"
                                     FontSize="13" />
                        </Grid>
                    </Border>

                    
                    <ComboBox Grid.Column="1"
                              Height="36"
                              Background="#1E1E2E"
                              Foreground="#CDD6F4"
                              BorderBrush="#313244"
                              Margin="0,0,10,0"
                              x:Name="StatusFilterCombo"
                              SelectionChanged="StatusFilterCombo_SelectionChanged">
                        <ComboBoxItem Content="All Tasks" IsSelected="True" />
                        <ComboBoxItem Content="Pending Only" />
                        <ComboBoxItem Content="Completed" />
                        <ComboBoxItem Content="Failed" />
                    </ComboBox>

                    
                    <Button Grid.Column="2"
                            Width="36"
                            Height="36"
                            Background="#1E1E2E"
                            BorderBrush="#313244"
                            BorderThickness="1"
                            Cursor="Hand"
                            ToolTip="Refresh Tasks"
                            Command="{Binding RefreshCommand}">
                        <Button.Resources>
                            <Style TargetType="{x:Type Border}">
                                <Setter Property="CornerRadius" Value="8" />
                            </Style>
                        </Button.Resources>
                        <TextBlock Text="🔄" FontSize="13" Foreground="#A6ADC8" />
                    </Button>
                </Grid>

                
                <Border Grid.Row="2"
                        Background="#1E1E2E"
                        CornerRadius="12"
                        BorderBrush="#313244"
                        BorderThickness="1"
                        Padding="12">
                    <Grid>
                        
                        <StackPanel VerticalAlignment="Center"
                                    HorizontalAlignment="Center"
                                    Visibility="{Binding FilteredTasks.Count, Converter={StaticResource BoolToVis}}">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding FilteredTasks.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="📝" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,10" />
                            <TextBlock Text="No tasks found"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="#CDD6F4"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="Create a task or clear filters to see your tasks."
                                       FontSize="12"
                                       Foreground="#6C7086"
                                       HorizontalAlignment="Center"
                                       Margin="0,4,0,0" />
                        </StackPanel>

                        
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding FilteredTasks}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,8"
                                                Padding="14,10"
                                                CornerRadius="10"
                                                Background="#181825"
                                                BorderBrush="#313244"
                                                BorderThickness="1">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#25263B" />
                                                            <Setter Property="BorderBrush" Value="#45475A" />
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    
                                                    <ColumnDefinition Width="Auto" />
                                                    
                                                    <ColumnDefinition Width="Auto" />
                                                    
                                                    <ColumnDefinition Width="*" />
                                                    
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                
                                                <Button Grid.Column="0"
                                                        Width="20"
                                                        Height="20"
                                                        Margin="0,0,12,0"
                                                        VerticalAlignment="Center"
                                                        Background="Transparent"
                                                        BorderThickness="1.5"
                                                        Cursor="Hand"
                                                        Command="{Binding DataContext.ToggleTaskStatusCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="Chk"
                                                                    CornerRadius="5"
                                                                    Background="Transparent"
                                                                    BorderBrush="#6C7086"
                                                                    BorderThickness="1.5">
                                                                <TextBlock x:Name="Txt"
                                                                           Text="✓"
                                                                           FontSize="12"
                                                                           FontWeight="Bold"
                                                                           Foreground="#10B981"
                                                                           HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center"
                                                                           Visibility="Collapsed" />
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <DataTrigger Binding="{Binding Status}" Value="Completed">
                                                                    <Setter TargetName="Txt" Property="Visibility" Value="Visible" />
                                                                    <Setter TargetName="Chk" Property="BorderBrush" Value="#10B981" />
                                                                    <Setter TargetName="Chk" Property="Background" Value="#10251E" />
                                                                </DataTrigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>

                                                
                                                <Border Grid.Column="1"
                                                        CornerRadius="6"
                                                        Padding="6,2"
                                                        Margin="0,0,12,0"
                                                        VerticalAlignment="Center"
                                                        Background="#25263B"
                                                        BorderBrush="{Binding Priority, Converter={StaticResource PriorityToBrush}}"
                                                        BorderThickness="1">
                                                    <TextBlock Text="{Binding Priority}"
                                                               FontSize="10.5"
                                                               FontWeight="SemiBold"
                                                               Foreground="{Binding Priority, Converter={StaticResource PriorityToBrush}}" />
                                                </Border>

                                                
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Title}"
                                                               FontSize="13.5"
                                                               FontWeight="Medium"
                                                               TextDecorations="{Binding Status, Converter={StaticResource StatusToStrikethrough}}"
                                                               Opacity="{Binding Status, Converter={StaticResource StatusToOpacity}}"
                                                               Foreground="#CDD6F4" />

                                                    
                                                    <TextBlock Text="{Binding Description}"
                                                               FontSize="11.5"
                                                               Foreground="#6C7086"
                                                               TextTrimming="CharacterEllipsis"
                                                               Margin="0,2,0,0">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                                <Style.Triggers>
                                                                    <Trigger Property="Text" Value="">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </Trigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>

                                                    
                                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                        <TextBlock Text="⏰ " FontSize="10" Foreground="#89B4FA" />
                                                        <TextBlock Text="{Binding EffectiveDueDate, Converter={StaticResource DueDateFormatter}}"
                                                                   FontSize="11"
                                                                   Foreground="#89B4FA" />
                                                        <Border Margin="8,0,0,0"
                                                                Padding="5,1"
                                                                CornerRadius="4"
                                                                Background="#181825"
                                                                BorderBrush="#89B4FA"
                                                                BorderThickness="1"
                                                                Visibility="{Binding IsRecurring, Converter={StaticResource BoolToVis}}">
                                                            <TextBlock Text="{Binding RecurringDaysSummary}" FontSize="10" FontWeight="SemiBold" Foreground="#89B4FA" />
                                                        </Border>
                                                        <Button Margin="8,0,0,0"
                                                                Cursor="Hand"
                                                                ToolTip="Play or pause voice note"
                                                                Visibility="{Binding HasVoiceNote, Converter={StaticResource BoolToVis}}"
                                                                Command="{Binding DataContext.ToggleVoiceNoteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}">
                                                            <Button.Template>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border x:Name="VnBorder" CornerRadius="4" Background="#181825" BorderBrush="#A6E3A1" BorderThickness="1" Padding="6,2">
                                                                        <StackPanel Orientation="Horizontal">
                                                                            <TextBlock Text="▶ " FontSize="10" Foreground="#A6E3A1" VerticalAlignment="Center" />
                                                                            <TextBlock Text="Voice Note (" FontSize="10" Foreground="#A6E3A1" VerticalAlignment="Center" />
                                                                            <TextBlock Text="{Binding VoiceNoteDurationText}" FontSize="10" FontWeight="SemiBold" Foreground="#A6E3A1" VerticalAlignment="Center" />
                                                                            <TextBlock Text=")" FontSize="10" Foreground="#A6E3A1" VerticalAlignment="Center" />
                                                                        </StackPanel>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="VnBorder" Property="Background" Value="#25263B" />
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Button.Template>
                                                        </Button>
                                                    </StackPanel>
                                                </StackPanel>

                                                
                                                <StackPanel Grid.Column="3"
                                                            Orientation="Horizontal"
                                                            VerticalAlignment="Center"
                                                            Margin="8,0,0,0">
                                                    
                                                    <Button Width="30"
                                                            Height="30"
                                                            Margin="0,0,4,0"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            Cursor="Hand"
                                                            ToolTip="Edit Task"
                                                            Command="{Binding DataContext.EditTaskCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border x:Name="EditBorder" CornerRadius="6" Background="Transparent">
                                                                    <TextBlock Text="✏️" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="EditBorder" Property="Background" Value="#313244" />
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>

                                                    
                                                    <Button Width="30"
                                                            Height="30"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            Cursor="Hand"
                                                            ToolTip="Delete Task"
                                                            Command="{Binding DataContext.DeleteTaskCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border x:Name="DelBorder" CornerRadius="6" Background="Transparent">
                                                                    <TextBlock Text="🗑️" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="DelBorder" Property="Background" Value="#3D2029" />
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            
            <ScrollViewer x:Name="StatsTabView" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="24,20">
                    <TextBlock Text="Performance &amp; Streaks"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="#CDD6F4" />
                    <TextBlock Text="Track your productivity consistency and overall completion records"
                               FontSize="12.5"
                               Foreground="#6C7086"
                               Margin="0,2,0,16" />

                    
                    <Border CornerRadius="14"
                            Padding="20"
                            Margin="0,0,0,18"
                            BorderThickness="1"
                            BorderBrush="#8B4513">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#3D201A" Offset="0" />
                                <GradientStop Color="#1E1E2E" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="🔥 DAILY STREAK"
                                           FontSize="11.5"
                                           FontWeight="Bold"
                                           Foreground="#FFAA44" />
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock Text="{Binding StreakCount}"
                                               FontSize="36"
                                               FontWeight="Bold"
                                               Foreground="#FFFFFF" />
                                    <TextBlock Text=" Days in a Row"
                                               FontSize="18"
                                               FontWeight="Medium"
                                               Foreground="#CDD6F4"
                                               VerticalAlignment="Bottom"
                                               Margin="8,0,0,6" />
                                </StackPanel>
                                <TextBlock Text="Complete all scheduled tasks today before midnight to keep your fire burning!"
                                           FontSize="12"
                                           Foreground="#A6ADC8"
                                           Margin="0,6,0,0" />
                            </StackPanel>

                            <TextBlock Grid.Column="1"
                                       Text="🔥"
                                       FontSize="64"
                                       VerticalAlignment="Center"
                                       Opacity="0.8" />
                        </Grid>
                    </Border>

                    
                    <UniformGrid Columns="3" Margin="-6,0,-6,12">
                        
                        <Border Style="{StaticResource StatCard}">
                            <StackPanel>
                                <TextBlock Text="🏆 Longest Streak" FontSize="12" FontWeight="Medium" Foreground="#6C7086" />
                                <TextBlock Text="{Binding LongestStreak, StringFormat='{}{0} Days'}"
                                           FontSize="22"
                                           FontWeight="Bold"
                                           Foreground="#CDD6F4"
                                           Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>

                        
                        <Border Style="{StaticResource StatCard}">
                            <StackPanel>
                                <TextBlock Text="✓ Completed Today" FontSize="12" FontWeight="Medium" Foreground="#6C7086" />
                                <TextBlock Text="{Binding CompletedToday, StringFormat='{}{0} Tasks'}"
                                           FontSize="22"
                                           FontWeight="Bold"
                                           Foreground="#10B981"
                                           Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>

                        
                        <Border Style="{StaticResource StatCard}">
                            <StackPanel>
                                <TextBlock Text="⏳ Pending Tasks" FontSize="12" FontWeight="Medium" Foreground="#6C7086" />
                                <TextBlock Text="{Binding PendingCount, StringFormat='{}{0} Tasks'}"
                                           FontSize="22"
                                           FontWeight="Bold"
                                           Foreground="#F59E0B"
                                           Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>

                        
                        <Border Style="{StaticResource StatCard}">
                            <StackPanel>
                                <TextBlock Text="📈 All-Time Completed" FontSize="12" FontWeight="Medium" Foreground="#6C7086" />
                                <TextBlock Text="{Binding TotalCompleted, StringFormat='{}{0} Tasks'}"
                                           FontSize="22"
                                           FontWeight="Bold"
                                           Foreground="#89B4FA"
                                           Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>

                        
                        <Border Style="{StaticResource StatCard}">
                            <StackPanel>
                                <TextBlock Text="⚠️ All-Time Failed" FontSize="12" FontWeight="Medium" Foreground="#6C7086" />
                                <TextBlock Text="{Binding TotalFailed, StringFormat='{}{0} Tasks'}"
                                           FontSize="22"
                                           FontWeight="Bold"
                                           Foreground="#F38BA8"
                                           Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>

                        
                        <Border Style="{StaticResource StatCard}">
                            <StackPanel>
                                <TextBlock Text="🎯 Completion Rate" FontSize="12" FontWeight="Medium" Foreground="#6C7086" />
                                <TextBlock Text="{Binding CompletionRate, StringFormat='{}{0:F1}%'}"
                                           FontSize="22"
                                           FontWeight="Bold"
                                           Foreground="#CBA6F7"
                                           Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </StackPanel>
            </ScrollViewer>

            
            <ScrollViewer x:Name="SettingsTabView" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="24,20" DataContext="{Binding SettingsVM}">
                    <TextBlock Text="Application Settings"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="#CDD6F4" />
                    <TextBlock Text="Customize widget appearance, behavioral modes, and reminder alerts"
                               FontSize="12.5"
                               Foreground="#6C7086"
                               Margin="0,2,0,16" />

                    
                    <Border Style="{StaticResource CardPanel}">
                        <StackPanel>
                            <TextBlock Text="🎨 Widget Appearance"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="#CDD6F4"
                                       Margin="0,0,0,14" />

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="140" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Background Color (#Hex)" VerticalAlignment="Center" Foreground="#A6ADC8" />
                                <TextBox Grid.Column="1"
                                         Text="{Binding WidgetBackgroundColor, UpdateSourceTrigger=PropertyChanged}"
                                         Background="#181825"
                                         Foreground="#CDD6F4"
                                         BorderBrush="#45475A"
                                         Padding="8,5" />
                            </Grid>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="140" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Accent Color (#Hex)" VerticalAlignment="Center" Foreground="#A6ADC8" />
                                <TextBox Grid.Column="1"
                                         Text="{Binding AccentColor, UpdateSourceTrigger=PropertyChanged}"
                                         Background="#181825"
                                         Foreground="#CDD6F4"
                                         BorderBrush="#45475A"
                                         Padding="8,5" />
                            </Grid>

                            
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="50" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Widget Opacity" VerticalAlignment="Center" Foreground="#A6ADC8" />
                                <Slider Grid.Column="1"
                                        Minimum="0.3"
                                        Maximum="1.0"
                                        Value="{Binding WidgetOpacity}"
                                        VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2"
                                           Text="{Binding WidgetOpacity, StringFormat='{}{0:P0}'}"
                                           Foreground="#CDD6F4"
                                           VerticalAlignment="Center"
                                           Margin="8,0,0,0" />
                            </Grid>

                            
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="50" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Corner Radius" VerticalAlignment="Center" Foreground="#A6ADC8" />
                                <Slider Grid.Column="1"
                                        Minimum="0"
                                        Maximum="28"
                                        Value="{Binding WidgetCornerRadius}"
                                        VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2"
                                           Text="{Binding WidgetCornerRadius, StringFormat='{}{0:F0}px'}"
                                           Foreground="#CDD6F4"
                                           VerticalAlignment="Center"
                                           Margin="8,0,0,0" />
                            </Grid>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="50" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Widget Width" VerticalAlignment="Center" Foreground="#A6ADC8" />
                                <Slider Grid.Column="1"
                                        Minimum="160"
                                        Maximum="500"
                                        Value="{Binding WidgetWidth}"
                                        VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2"
                                           Text="{Binding WidgetWidth, StringFormat='{}{0:F0}px'}"
                                           Foreground="#CDD6F4"
                                           VerticalAlignment="Center"
                                           Margin="8,0,0,0" />
                            </Grid>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="50" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Widget Height" VerticalAlignment="Center" Foreground="#A6ADC8" />
                                <Slider Grid.Column="1"
                                        Minimum="160"
                                        Maximum="700"
                                        Value="{Binding WidgetHeight}"
                                        VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2"
                                           Text="{Binding WidgetHeight, StringFormat='{}{0:F0}px'}"
                                           Foreground="#CDD6F4"
                                           VerticalAlignment="Center"
                                           Margin="8,0,0,0" />
                            </Grid>

                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="140" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Widget Font Family" VerticalAlignment="Center" Foreground="#A6ADC8" />
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding AvailableFonts}"
                                          SelectedItem="{Binding FontFamily}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardPanel}">
                        <StackPanel>
                            <TextBlock Text="📌 Widget Behavior &amp; Placement"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="#CDD6F4"
                                       Margin="0,0,0,14" />

                            <TextBlock Text="Placement Mode:" Foreground="#A6ADC8" Margin="0,0,0,8" />
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                <RadioButton Content="Float Always on Top"
                                             IsChecked="{Binding IsFloatOnTop}"
                                             Foreground="#CDD6F4"
                                             Margin="0,0,24,0" />
                                <RadioButton Content="Pin Directly to Desktop (Under Windows)"
                                             IsChecked="{Binding IsPinnedToDesktop}"
                                             Foreground="#CDD6F4" />
                            </StackPanel>

                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="140" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Desktop Position" Foreground="#A6ADC8" />
                                    <TextBlock Text="Screen dock preset or draggable" FontSize="11" Foreground="#6C7086" Margin="0,2,0,0" />
                                </StackPanel>
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding AvailableDockPositions}"
                                          SelectedItem="{Binding DockPosition}"
                                          Height="34" />
                            </Grid>

                            <CheckBox Content="Show Desktop Widget"
                                      IsChecked="{Binding WidgetVisible}"
                                      Foreground="#CDD6F4"
                                      Margin="0,0,0,10" />

                            <CheckBox Content="Show Streak Badge on Widget"
                                      IsChecked="{Binding ShowStreakOnWidget}"
                                      Foreground="#CDD6F4" />
                        </StackPanel>
                    </Border>

                    
                    <Border Style="{StaticResource CardPanel}">
                        <StackPanel>
                            <TextBlock Text="🔔 Reminders &amp; Alerts"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="#CDD6F4"
                                       Margin="0,0,0,14" />

                            <CheckBox Content="Enable Due Date Notifications"
                                      IsChecked="{Binding NotificationsEnabled}"
                                      Foreground="#CDD6F4"
                                      Margin="0,0,0,10" />

                            <CheckBox Content="Play Sound on Notifications"
                                      IsChecked="{Binding NotificationSoundEnabled}"
                                      Foreground="#CDD6F4"
                                      Margin="0,0,0,14" />

                            
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="140" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Default Snooze Duration" VerticalAlignment="Center" Foreground="#A6ADC8" />
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding SnoozeOptions}"
                                          SelectedItem="{Binding DefaultSnoozeDurationMinutes}"
                                          Background="#181825"
                                          Foreground="#CDD6F4"
                                          BorderBrush="#45475A">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding StringFormat='{}{0} minutes'}" Foreground="#CDD6F4" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </Grid>

                            
                            <TextBlock Text="Reminder Intervals (Minutes before due time):"
                                       Foreground="#A6ADC8"
                                       Margin="0,0,0,8" />
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <ItemsControl ItemsSource="{Binding ReminderIntervals}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#313244"
                                                    CornerRadius="6"
                                                    Padding="8,4"
                                                    Margin="0,0,8,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding StringFormat='{}{0}m'}"
                                                               Foreground="#CDD6F4"
                                                               FontSize="12" />
                                                    <Button Content="✕"
                                                            Margin="6,0,0,0"
                                                            FontSize="10"
                                                            Background="Transparent"
                                                            Foreground="#F38BA8"
                                                            BorderThickness="0"
                                                            Cursor="Hand"
                                                            Command="{Binding DataContext.RemoveReminderCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            
                            <StackPanel Orientation="Horizontal">
                                <TextBox Width="80"
                                         Text="{Binding NewReminderMinutes, UpdateSourceTrigger=PropertyChanged}"
                                         Background="#181825"
                                         Foreground="#CDD6F4"
                                         BorderBrush="#45475A"
                                         Padding="6,4"
                                         Margin="0,0,8,0" />
                                <Button Content="+ Add Interval"
                                        Padding="12,4"
                                        Background="#313244"
                                        Foreground="#CDD6F4"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        Command="{Binding AddReminderCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    
                    <Border Style="{StaticResource CardPanel}">
                        <StackPanel>
                            <TextBlock Text="💻 System &amp; Startup"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="#CDD6F4"
                                       Margin="0,0,0,14" />

                            <CheckBox Content="Launch automatically on Windows startup"
                                      IsChecked="{Binding LaunchOnStartup}"
                                      Foreground="#CDD6F4"
                                      Margin="0,0,0,10" />

                            <CheckBox Content="Start minimized to system tray icon"
                                      IsChecked="{Binding StartMinimized}"
                                      Foreground="#CDD6F4"
                                      Margin="0,0,0,14" />

                            
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="140" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Application Theme" VerticalAlignment="Center" Foreground="#A6ADC8" />
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding AvailableThemes}"
                                          SelectedItem="{Binding Theme}"
                                          Background="#181825"
                                          Foreground="#CDD6F4"
                                          BorderBrush="#45475A" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Updates & Version Card -->
                    <Border Style="{StaticResource CardPanel}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="🔄 App Updates &amp; Version"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="#CDD6F4"
                                       Margin="0,0,0,12" />

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Installed Version" Foreground="#A6ADC8" FontSize="12" />
                                    <TextBlock Text="{Binding CurrentVersionText}" Foreground="#CDD6F4" FontSize="14" FontWeight="SemiBold" Margin="0,2,0,0" />
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Content="Check for Updates"
                                        Padding="14,6"
                                        Background="#25263B"
                                        Foreground="#CDD6F4"
                                        BorderBrush="#45475A"
                                        BorderThickness="1"
                                        Cursor="Hand"
                                        Command="{Binding CheckForUpdatesCommand}">
                                    <Button.Resources>
                                        <Style TargetType="{x:Type Border}">
                                            <Setter Property="CornerRadius" Value="6" />
                                        </Style>
                                    </Button.Resources>
                                </Button>
                            </Grid>

                            <CheckBox Content="Automatically check for updates on startup"
                                      IsChecked="{Binding CheckForUpdatesOnStartup}"
                                      Foreground="#CDD6F4"
                                      Margin="0,0,0,10" />

                            <StackPanel Visibility="{Binding Updater.StatusMessage, Converter={StaticResource StringToVis}}" Margin="0,4,0,0">
                                <TextBlock Text="{Binding Updater.StatusMessage}"
                                           Foreground="#89B4FA"
                                           FontSize="12"
                                           Margin="0,0,0,6" />

                                <ProgressBar Height="6"
                                             Minimum="0"
                                             Maximum="100"
                                             Value="{Binding Updater.DownloadProgress, Mode=OneWay}"
                                             Visibility="{Binding Updater.IsDownloading, Converter={StaticResource BoolToVis}}"
                                             Foreground="#10B981"
                                             Background="#181825"
                                             Margin="0,0,0,6" />
                            </StackPanel>

                            <Border Background="#1E2A38"
                                    BorderBrush="#3B82F6"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="12,10"
                                    Margin="0,8,0,0"
                                    Visibility="{Binding Updater.HasUpdateAvailable, Converter={StaticResource BoolToVis}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="A new update is available!" FontWeight="SemiBold" Foreground="#89B4FA" FontSize="12.5" />
                                        <TextBlock Text="{Binding Updater.AvailableUpdate.Title}" Foreground="#CDD6F4" FontSize="11.5" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Content="Download &amp; Install"
                                            Background="#10B981"
                                            Foreground="#FFFFFF"
                                            FontWeight="SemiBold"
                                            Padding="14,6"
                                            BorderThickness="0"
                                            Cursor="Hand"
                                            Command="{Binding InstallUpdateCommand}">
                                        <Button.Resources>
                                            <Style TargetType="{x:Type Border}">
                                                <Setter Property="CornerRadius" Value="6" />
                                            </Style>
                                        </Button.Resources>
                                    </Button>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardPanel}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="👋 About the Dev"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="#CDD6F4"
                                       Margin="0,0,0,10" />

                            <TextBlock TextWrapping="Wrap"
                                       Foreground="#A6ADC8"
                                       FontSize="12.5"
                                       LineHeight="19"
                                       Text="Heyy, I am Kartik and I am just a guy with some what exprience with coading. This is my first time making a full windows app using C#. I made this is app with the sole purpose of killing the procastination, It will remind you to complete task even if you forgot to complete it and started doing something in your PC. Hopefully you find this app helpful" />

                            <Border Margin="0,12,0,0"
                                    HorizontalAlignment="Left"
                                    CornerRadius="6"
                                    Background="#181825"
                                    BorderBrush="#313244"
                                    BorderThickness="1"
                                    Padding="10,6">
                                <TextBlock>
                                    <Run Text="🔗 GitHub: " Foreground="#89B4FA" FontWeight="Medium" FontSize="12" />
                                    <Hyperlink NavigateUri="https://github.com/Kartik-048"
                                               RequestNavigate="Hyperlink_RequestNavigate"
                                               Foreground="#3B82F6"
                                               TextDecorations="None">
                                        <Run Text="https://github.com/Kartik-048" />
                                    </Hyperlink>
                                </TextBlock>
                            </Border>
                        </StackPanel>
                    </Border>

                    
                    <Grid Margin="0,8,0,24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Content="Save Changes"
                                Height="38"
                                Padding="20,0"
                                FontSize="13.5"
                                FontWeight="SemiBold"
                                Background="#3B82F6"
                                Foreground="#FFFFFF"
                                BorderThickness="0"
                                Cursor="Hand"
                                Command="{Binding SaveCommand}"
                                Margin="0,0,10,0">
                            <Button.Resources>
                                <Style TargetType="{x:Type Border}">
                                    <Setter Property="CornerRadius" Value="8" />
                                </Style>
                            </Button.Resources>
                        </Button>

                        <Button Grid.Column="1"
                                Content="Reset Defaults"
                                Height="38"
                                Padding="16,0"
                                FontSize="13"
                                Background="#313244"
                                Foreground="#CDD6F4"
                                BorderThickness="0"
                                Cursor="Hand"
                                Command="{Binding ResetDefaultsCommand}">
                            <Button.Resources>
                                <Style TargetType="{x:Type Border}">
                                    <Setter Property="CornerRadius" Value="8" />
                                </Style>
                            </Button.Resources>
                        </Button>

                        
                        <TextBlock Grid.Column="2"
                                   Text="{Binding StatusMessage}"
                                   Foreground="#10B981"
                                   FontSize="13"
                                   FontWeight="Medium"
                                   VerticalAlignment="Center"
                                   Margin="16,0,0,0" />
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
