<Window x:Class="TodoWidget.Views.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:TodoWidget.Converters"
        xmlns:models="clr-namespace:TodoWidget.Models"
        mc:Ignorable="d"
        Title="To-Do - Task &amp; Settings Manager"
        Width="980"
        Height="700"
        MinWidth="880"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="#0E101A"
        Foreground="#CDD6F4">

    <Window.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:BooleanToVisibilityConverter x:Key="InvBoolToVis" Invert="True" />
        <converters:StringToVisibilityConverter x:Key="StringToVis" />
        <converters:InverseBooleanConverter x:Key="InvBool" />
        <converters:PriorityToBrushConverter x:Key="PriorityToBrush" />
        <converters:DueDateFormatterConverter x:Key="DueDateFormatter" />
        <converters:StatusToBrushConverter x:Key="StatusToBrush" />
        <converters:StatusToStrikethroughConverter x:Key="StatusToStrikethrough" />
        <converters:StatusToOpacityConverter x:Key="StatusToOpacity" />

        <!-- Modern Sidebar Nav Button -->
        <Style x:Key="SidebarNavButton" TargetType="RadioButton">
            <Setter Property="Height" Value="42" />
            <Setter Property="Margin" Value="0,3,0,3" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#9BA3C7" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="NavBorder"
                                CornerRadius="8"
                                Background="{TemplateBinding Background}"
                                Padding="14,0">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavBorder" Property="Background" Value="#171A29" />
                                <Setter Property="Foreground" Value="#E0E5FB" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="NavBorder" Property="Background" Value="#252A42" />
                                <Setter Property="Foreground" Value="#89B4FA" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Card Style -->
        <Style x:Key="CardPanel" TargetType="Border">
            <Setter Property="Background" Value="#141724" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="BorderBrush" Value="#23273D" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="18" />
            <Setter Property="Margin" Value="0,0,0,16" />
        </Style>

        <!-- Stat Card Style -->
        <Style x:Key="StatCard" TargetType="Border">
            <Setter Property="Background" Value="#141724" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="BorderBrush" Value="#23273D" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="6" />
        </Style>

        <!-- Task Row Edit Button Style -->
        <Style x:Key="TaskEditButton" TargetType="Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Background" Value="#161928" />
            <Setter Property="BorderBrush" Value="#23273D" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                CornerRadius="6"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1C2640" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#3B82F6" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1D386B" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Task Row Delete Button Style -->
        <Style x:Key="TaskDeleteButton" TargetType="Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Background" Value="#161928" />
            <Setter Property="BorderBrush" Value="#23273D" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                CornerRadius="6"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#351C28" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#F38BA8" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#4A2033" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Task Row Voice Note Button Style -->
        <Style x:Key="VoiceNotePlayButton" TargetType="Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Background" Value="#161928" />
            <Setter Property="BorderBrush" Value="#23273D" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                CornerRadius="6"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#132B22" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#10B981" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1B4234" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Left Navigation Rail -->
            <ColumnDefinition Width="230" />
            <!-- Main Content Area -->
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ================= LEFT SIDEBAR ================= -->
        <Border Grid.Column="0"
                Background="#0A0B12"
                BorderBrush="#1D2134"
                BorderThickness="0,0,1,0"
                Padding="16,22">
            <Grid>
                <Grid.RowDefinitions>
                    <!-- Header -->
                    <RowDefinition Height="Auto" />
                    <!-- Navigation Links -->
                    <RowDefinition Height="*" />
                    <!-- Profile & Streak Pill Footer -->
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- App Branding -->
                <StackPanel Grid.Row="0" Margin="0,0,0,26">
                    <TextBlock Text="To-Do"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="#FFFFFF" />
                    <TextBlock Text="Desktop Companion v5.0.0"
                               FontSize="11.5"
                               Foreground="#60678A"
                               Margin="0,2,0,0" />
                </StackPanel>

                <!-- Navigation Tabs -->
                <StackPanel Grid.Row="1">
                    <RadioButton Style="{StaticResource SidebarNavButton}"
                                 GroupName="NavTabs"
                                 IsChecked="True"
                                 Checked="NavTasks_Checked"
                                 x:Name="NavTasksRadio">
                        <TextBlock Text="Tasks" VerticalAlignment="Center" />
                    </RadioButton>

                    <RadioButton Style="{StaticResource SidebarNavButton}"
                                 GroupName="NavTabs"
                                 Checked="NavStats_Checked"
                                 x:Name="NavStatsRadio">
                        <TextBlock Text="Stats &amp; Streaks" VerticalAlignment="Center" />
                    </RadioButton>

                    <RadioButton Style="{StaticResource SidebarNavButton}"
                                 GroupName="NavTabs"
                                 Checked="NavAccount_Checked"
                                 x:Name="NavAccountRadio">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Account &amp; Sync" VerticalAlignment="Center" />
                            <Ellipse Width="6" Height="6" Fill="#10B981" Margin="8,0,0,0" VerticalAlignment="Center"
                                     Visibility="{Binding CloudSync.IsConnected, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton Style="{StaticResource SidebarNavButton}"
                                 GroupName="NavTabs"
                                 Checked="NavBlocker_Checked"
                                 x:Name="NavBlockerRadio">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="App Blocker" VerticalAlignment="Center" />
                            <Border Margin="8,0,0,0"
                                    Padding="6,1"
                                    CornerRadius="8"
                                    Background="#23273D"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding BlockedApps.Count, FallbackValue='0'}"
                                           FontSize="10.5"
                                           FontWeight="Bold"
                                           Foreground="#89B4FA" />
                            </Border>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton Style="{StaticResource SidebarNavButton}"
                                 GroupName="NavTabs"
                                 Checked="NavSettings_Checked"
                                 x:Name="NavSettingsRadio">
                        <TextBlock Text="Settings" VerticalAlignment="Center" />
                    </RadioButton>
                </StackPanel>

                <!-- Bottom User Profile & Streak Footer -->
                <Border Grid.Row="2"
                        Background="#141724"
                        CornerRadius="10"
                        Padding="12,10"
                        BorderBrush="#23273D"
                        BorderThickness="1">
                    <StackPanel>
                        <!-- Account sync indicator -->
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="CLOUD SYNC"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="#60678A" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding CloudSync.Username, FallbackValue='Local Mode'}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="#89B4FA" />
                        </Grid>

                        <Separator Background="#23273D" Margin="0,2,0,8" />

                        <!-- Streak counter -->
                        <TextBlock Text="Active Streak"
                                   FontSize="10.5"
                                   Foreground="#60678A" />
                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                            <Ellipse Width="7"
                                     Height="7"
                                     Fill="#FFAA44"
                                     Margin="0,0,6,0"
                                     VerticalAlignment="Center" />
                            <TextBlock Text="{Binding StreakCount}"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       Foreground="#FFAA44"
                                       VerticalAlignment="Center" />
                            <TextBlock Text=" Days Active"
                                       FontSize="11.5"
                                       Foreground="#9BA3C7"
                                       VerticalAlignment="Center"
                                       Margin="4,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ================= MAIN CONTENT VIEWS ================= -->
        <Grid Grid.Column="1" Background="#0E101A">

            <!-- ================= TAB 0: TASKS OVERVIEW ================= -->
            <Grid x:Name="TasksTabView" Visibility="Visible" Margin="26,22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Tasks Header -->
                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Task Overview"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="#FFFFFF" />
                        <TextBlock Text="Manage, organize, and prioritize your daily schedule"
                                   FontSize="12.5"
                                   Foreground="#60678A"
                                   Margin="0,2,0,0" />
                    </StackPanel>

                    <Button Grid.Column="1"
                            Content="+ New Task"
                            Height="38"
                            Padding="18,0"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Background="#3B82F6"
                            Foreground="#FFFFFF"
                            BorderThickness="0"
                            Cursor="Hand"
                            Command="{Binding AddTaskCommand}">
                        <Button.Resources>
                            <Style TargetType="{x:Type Border}">
                                <Setter Property="CornerRadius" Value="8" />
                            </Style>
                        </Button.Resources>
                    </Button>
                </Grid>

                <!-- Search & Filters Toolbar -->
                <Grid Grid.Row="1" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Background="#141724"
                            CornerRadius="8"
                            BorderBrush="#23273D"
                            BorderThickness="1"
                            Margin="0,0,10,0">
                        <Grid>
                            <TextBlock Text="Search tasks..."
                                       Foreground="#60678A"
                                       FontSize="12.5"
                                       Margin="12,9,0,0"
                                       IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding FilterText}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBox Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                                     Background="Transparent"
                                     Foreground="#E0E5FB"
                                     CaretBrush="#3B82F6"
                                     BorderThickness="0"
                                     Padding="12,8"
                                     FontSize="13" />
                        </Grid>
                    </Border>

                    <ComboBox Grid.Column="1"
                              Height="36"
                              Background="#141724"
                              Foreground="#E0E5FB"
                              BorderBrush="#23273D"
                              Margin="0,0,10,0"
                              x:Name="StatusFilterCombo"
                              SelectionChanged="StatusFilterCombo_SelectionChanged">
                        <ComboBoxItem Content="All Tasks" IsSelected="True" />
                        <ComboBoxItem Content="Pending Only" />
                        <ComboBoxItem Content="Completed" />
                        <ComboBoxItem Content="Failed" />
                    </ComboBox>

                    <Button Grid.Column="2"
                            Width="36"
                            Height="36"
                            Padding="0"
                            Background="#141724"
                            BorderBrush="#23273D"
                            BorderThickness="1"
                            Cursor="Hand"
                            ToolTip="Refresh Tasks"
                            Command="{Binding RefreshCommand}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd"
                                        CornerRadius="8"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}">
                                    <TextBlock Text="⟳" FontSize="15" Foreground="#9BA3C7" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#1C2033" />
                                        <Setter TargetName="Bd" Property="BorderBrush" Value="#3B82F6" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <!-- Tasks Scrollable Card Container -->
                <Border Grid.Row="2"
                        Background="#141724"
                        CornerRadius="12"
                        BorderBrush="#23273D"
                        BorderThickness="1"
                        Padding="12">
                    <Grid>
                        <!-- Empty State -->
                        <StackPanel VerticalAlignment="Center"
                                    HorizontalAlignment="Center"
                                    Visibility="{Binding FilteredTasks.Count, Converter={StaticResource BoolToVis}}">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding FilteredTasks.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="✓" FontSize="32" FontWeight="Bold" Foreground="#3B82F6" HorizontalAlignment="Center" Margin="0,0,0,10" />
                            <TextBlock Text="No tasks found"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="#E0E5FB"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="Create a task or clear filters to view tasks."
                                       FontSize="12"
                                       Foreground="#60678A"
                                       HorizontalAlignment="Center"
                                       Margin="0,4,0,0" />
                        </StackPanel>

                        <!-- Tasks Items -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding FilteredTasks}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,8"
                                                Padding="14,10"
                                                CornerRadius="10"
                                                Background="#0E101A"
                                                BorderBrush="#23273D"
                                                BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Complete Checkbox -->
                                                <Button Grid.Column="0"
                                                        Width="20"
                                                        Height="20"
                                                        Margin="0,0,12,0"
                                                        VerticalAlignment="Center"
                                                        Background="Transparent"
                                                        BorderThickness="1.5"
                                                        Cursor="Hand"
                                                        Command="{Binding DataContext.ToggleTaskStatusCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="Chk"
                                                                    CornerRadius="5"
                                                                    Background="Transparent"
                                                                    BorderBrush="#60678A"
                                                                    BorderThickness="1.5">
                                                                <TextBlock x:Name="Txt"
                                                                           Text="✓"
                                                                           FontSize="12"
                                                                           FontWeight="Bold"
                                                                           Foreground="#10B981"
                                                                           HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center"
                                                                           Visibility="Collapsed" />
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <DataTrigger Binding="{Binding Status}" Value="Completed">
                                                                    <Setter TargetName="Txt" Property="Visibility" Value="Visible" />
                                                                    <Setter TargetName="Chk" Property="BorderBrush" Value="#10B981" />
                                                                    <Setter TargetName="Chk" Property="Background" Value="#0F281E" />
                                                                </DataTrigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>

                                                <!-- Priority Badge -->
                                                <Border Grid.Column="1"
                                                        CornerRadius="6"
                                                        Padding="6,2"
                                                        Margin="0,0,12,0"
                                                        VerticalAlignment="Center"
                                                        Background="#181B2B"
                                                        BorderBrush="{Binding Priority, Converter={StaticResource PriorityToBrush}}"
                                                        BorderThickness="1">
                                                    <TextBlock Text="{Binding Priority}"
                                                               FontSize="10"
                                                               FontWeight="SemiBold"
                                                               Foreground="{Binding Priority, Converter={StaticResource PriorityToBrush}}" />
                                                </Border>

                                                <!-- Title & Details -->
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Title}"
                                                               FontSize="13.5"
                                                               FontWeight="Medium"
                                                               TextDecorations="{Binding Status, Converter={StaticResource StatusToStrikethrough}}"
                                                               Opacity="{Binding Status, Converter={StaticResource StatusToOpacity}}"
                                                               Foreground="#E0E5FB" />

                                                    <TextBlock Text="{Binding Description}"
                                                               FontSize="11.5"
                                                               Foreground="#60678A"
                                                               TextTrimming="CharacterEllipsis"
                                                               Margin="0,2,0,0">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                                <Style.Triggers>
                                                                    <Trigger Property="Text" Value="">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </Trigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>

                                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                        <TextBlock Text="Due: " FontSize="10.5" Foreground="#89B4FA" />
                                                        <TextBlock Text="{Binding EffectiveDueDate, Converter={StaticResource DueDateFormatter}}"
                                                                   FontSize="10.5"
                                                                   Foreground="#89B4FA" />
                                                        <Border Margin="8,0,0,0"
                                                                Padding="5,1"
                                                                CornerRadius="4"
                                                                Background="#141724"
                                                                BorderBrush="#89B4FA"
                                                                BorderThickness="1"
                                                                Visibility="{Binding IsRecurring, Converter={StaticResource BoolToVis}}">
                                                            <TextBlock Text="{Binding RecurringDaysSummary}" FontSize="10" FontWeight="SemiBold" Foreground="#89B4FA" />
                                                        </Border>
                                                    </StackPanel>
                                                </StackPanel>

                                                <!-- Action Buttons -->
                                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                                                    <!-- Voice Note Play Button (Visible only if has voice note) -->
                                                    <Button Style="{StaticResource VoiceNotePlayButton}"
                                                            Margin="0,0,4,0"
                                                            ToolTip="Play Voice Memo"
                                                            Visibility="{Binding HasVoiceNote, Converter={StaticResource BoolToVis}}"
                                                            Command="{Binding DataContext.ToggleVoiceNoteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}">
                                                        <TextBlock Text="▶" FontSize="10" Foreground="#A6E3A1" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Button>

                                                    <!-- Edit Task Button -->
                                                    <Button Style="{StaticResource TaskEditButton}"
                                                            Margin="0,0,4,0"
                                                            ToolTip="Edit Task"
                                                            Command="{Binding DataContext.EditTaskCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}">
                                                        <TextBlock Text="✎" FontSize="12.5" Foreground="#CDD6F4" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Button>

                                                    <!-- Delete Task Button -->
                                                    <Button Style="{StaticResource TaskDeleteButton}"
                                                            ToolTip="Delete Task"
                                                            Command="{Binding DataContext.DeleteTaskCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}">
                                                        <TextBlock Text="✕" FontSize="11.5" Foreground="#F38BA8" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <!-- ================= TAB 1: STATS & STREAKS ================= -->
            <ScrollViewer x:Name="StatsTabView" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="26,22">
                    <TextBlock Text="Performance &amp; Streaks"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="#FFFFFF" />
                    <TextBlock Text="Track your productivity consistency and overall completion records"
                               FontSize="12.5"
                               Foreground="#60678A"
                               Margin="0,2,0,18" />

                    <!-- Hero Streak Card -->
                    <Border CornerRadius="14"
                            Padding="22"
                            Margin="0,0,0,18"
                            BorderThickness="1"
                            BorderBrush="#7B3A1C"
                            Background="#1F1614">
                        <Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="CURRENT ACTIVE STREAK"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="#FFAA44" />
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Text="{Binding StreakCount}"
                                               FontSize="40"
                                               FontWeight="Bold"
                                               Foreground="#FFFFFF" />
                                    <TextBlock Text=" Days in a Row"
                                               FontSize="18"
                                               FontWeight="Medium"
                                               Foreground="#CDD6F4"
                                               VerticalAlignment="Bottom"
                                               Margin="8,0,0,8" />
                                </StackPanel>
                                <TextBlock Text="Complete all scheduled tasks today before midnight to maintain your streak."
                                           FontSize="12"
                                           Foreground="#A6ADC8"
                                           Margin="0,6,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Metrics Grid -->
                    <UniformGrid Columns="3" Margin="-6,0,-6,12">
                        <Border Style="{StaticResource StatCard}">
                            <StackPanel>
                                <TextBlock Text="Longest Streak" FontSize="11.5" FontWeight="Medium" Foreground="#60678A" />
                                <TextBlock Text="{Binding LongestStreak, StringFormat='{}{0} Days'}"
                                           FontSize="22"
                                           FontWeight="Bold"
                                           Foreground="#FFFFFF"
                                           Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource StatCard}">
                            <StackPanel>
                                <TextBlock Text="Completed Today" FontSize="11.5" FontWeight="Medium" Foreground="#60678A" />
                                <TextBlock Text="{Binding CompletedToday, StringFormat='{}{0} Tasks'}"
                                           FontSize="22"
                                           FontWeight="Bold"
                                           Foreground="#10B981"
                                           Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource StatCard}">
                            <StackPanel>
                                <TextBlock Text="Pending Tasks" FontSize="11.5" FontWeight="Medium" Foreground="#60678A" />
                                <TextBlock Text="{Binding PendingCount, StringFormat='{}{0} Tasks'}"
                                           FontSize="22"
                                           FontWeight="Bold"
                                           Foreground="#F59E0B"
                                           Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource StatCard}">
                            <StackPanel>
                                <TextBlock Text="All-Time Completed" FontSize="11.5" FontWeight="Medium" Foreground="#60678A" />
                                <TextBlock Text="{Binding TotalCompleted, StringFormat='{}{0} Tasks'}"
                                           FontSize="22"
                                           FontWeight="Bold"
                                           Foreground="#89B4FA"
                                           Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource StatCard}">
                            <StackPanel>
                                <TextBlock Text="All-Time Failed" FontSize="11.5" FontWeight="Medium" Foreground="#60678A" />
                                <TextBlock Text="{Binding TotalFailed, StringFormat='{}{0} Tasks'}"
                                           FontSize="22"
                                           FontWeight="Bold"
                                           Foreground="#F38BA8"
                                           Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource StatCard}">
                            <StackPanel>
                                <TextBlock Text="Completion Rate" FontSize="11.5" FontWeight="Medium" Foreground="#60678A" />
                                <TextBlock Text="{Binding CompletionRate, StringFormat='{}{0:F1}%'}"
                                           FontSize="22"
                                           FontWeight="Bold"
                                           Foreground="#CBA6F7"
                                           Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </StackPanel>
            </ScrollViewer>

            <!-- ================= TAB 2: ACCOUNT & CLOUD SYNC ================= -->
            <ScrollViewer x:Name="AccountTabView" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="26,22">
                    <TextBlock Text="Account &amp; Cloud Sync"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="#FFFFFF" />
                    <TextBlock Text="Sync your tasks, daily streaks, and settings across all your Windows devices using GitHub"
                               FontSize="12.5"
                               Foreground="#60678A"
                               Margin="0,2,0,18" />

                    <!-- NOT CONNECTED CARD -->
                    <Border Style="{StaticResource CardPanel}" Visibility="{Binding CloudSync.IsConnected, Converter={StaticResource InvBoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="Connect GitHub Account"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="#FFFFFF"
                                       Margin="0,0,0,8" />
                            <TextBlock Text="To-Do uses a private, encrypted GitHub Gist to sync your tasks and streak across computers without any subscription or third-party servers."
                                       FontSize="12"
                                       Foreground="#9BA3C7"
                                       TextWrapping="Wrap"
                                       LineHeight="18"
                                       Margin="0,0,0,16" />

                            <Border Background="#0E101A"
                                    BorderBrush="#23273D"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="14"
                                    Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="Setup Instructions:" FontWeight="SemiBold" Foreground="#89B4FA" FontSize="12.5" Margin="0,0,0,6" />
                                    <TextBlock Text="1. Go to GitHub -> Settings -> Developer settings -> Personal access tokens (classic)."
                                               FontSize="12" Foreground="#CDD6F4" Margin="0,0,0,4" />
                                    <TextBlock Text="2. Generate a token with the 'gist' scope checked."
                                               FontSize="12" Foreground="#CDD6F4" Margin="0,0,0,8" />
                                    <TextBlock>
                                        <Hyperlink NavigateUri="https://github.com/settings/tokens/new?scopes=gist&amp;description=To-Do%20App%20Sync"
                                                   RequestNavigate="Hyperlink_RequestNavigate"
                                                   Foreground="#3B82F6">
                                            Click here to open GitHub Token Creation Page
                                        </Hyperlink>
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="Personal Access Token:"
                                       FontSize="12"
                                       Foreground="#9BA3C7"
                                       Margin="0,0,0,6" />
                            <TextBox Text="{Binding GitHubTokenInput, UpdateSourceTrigger=PropertyChanged}"
                                     Background="#0E101A"
                                     Foreground="#FFFFFF"
                                     BorderBrush="#23273D"
                                     Padding="10,8"
                                     FontSize="13"
                                     Margin="0,0,0,14" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Button Content="Connect &amp; Sync Account"
                                        Height="38"
                                        Padding="20,0"
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Background="#3B82F6"
                                        Foreground="#FFFFFF"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        Command="{Binding ConnectGitHubCommand}"
                                        IsEnabled="{Binding CloudSync.IsSyncing, Converter={StaticResource InvBool}}">
                                    <Button.Resources>
                                        <Style TargetType="{x:Type Border}">
                                            <Setter Property="CornerRadius" Value="8" />
                                        </Style>
                                    </Button.Resources>
                                </Button>

                                <TextBlock Grid.Column="1"
                                           Text="{Binding CloudSync.StatusMessage}"
                                           Foreground="#FFAA44"
                                           FontSize="12"
                                           VerticalAlignment="Center"
                                           Margin="16,0,0,0" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- CONNECTED CARD -->
                    <Border Style="{StaticResource CardPanel}" Visibility="{Binding CloudSync.IsConnected, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="8" Height="8" Fill="#10B981" Margin="0,0,8,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Account Connected"
                                                   FontSize="16"
                                                   FontWeight="SemiBold"
                                                   Foreground="#FFFFFF" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding CloudSync.Username, StringFormat='Logged in as @{0}'}"
                                               FontSize="13"
                                               Foreground="#89B4FA"
                                               Margin="16,4,0,0" />
                                </StackPanel>

                                <Button Grid.Column="1"
                                        Content="Disconnect"
                                        Padding="14,6"
                                        Background="#25161A"
                                        Foreground="#F38BA8"
                                        BorderBrush="#502530"
                                        BorderThickness="1"
                                        Cursor="Hand"
                                        Command="{Binding DisconnectGitHubCommand}">
                                    <Button.Resources>
                                        <Style TargetType="{x:Type Border}">
                                            <Setter Property="CornerRadius" Value="6" />
                                        </Style>
                                    </Button.Resources>
                                </Button>
                            </Grid>

                            <Border Background="#0E101A"
                                    BorderBrush="#23273D"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="14"
                                    Margin="0,0,0,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Cloud Sync Status" FontSize="11" Foreground="#60678A" />
                                        <TextBlock Text="{Binding CloudSync.LastSyncText, StringFormat='Last synced: {0}'}"
                                                   FontSize="13"
                                                   Foreground="#E0E5FB"
                                                   Margin="0,2,0,0" />
                                        <TextBlock Text="{Binding CloudSync.StatusMessage}"
                                                   FontSize="11.5"
                                                   Foreground="#10B981"
                                                   Margin="0,2,0,0"
                                                   Visibility="{Binding CloudSync.StatusMessage, Converter={StaticResource StringToVis}}" />
                                    </StackPanel>

                                    <Button Grid.Column="1"
                                            Content="Sync Now"
                                            Height="34"
                                            Padding="18,0"
                                            FontSize="12.5"
                                            FontWeight="SemiBold"
                                            Background="#3B82F6"
                                            Foreground="#FFFFFF"
                                            BorderThickness="0"
                                            Cursor="Hand"
                                            Command="{Binding SyncNowCommand}"
                                            IsEnabled="{Binding CloudSync.IsSyncing, Converter={StaticResource InvBool}}">
                                        <Button.Resources>
                                            <Style TargetType="{x:Type Border}">
                                                <Setter Property="CornerRadius" Value="6" />
                                            </Style>
                                        </Button.Resources>
                                    </Button>
                                </Grid>
                            </Border>

                            <CheckBox Content="Automatically sync tasks and streak after changes"
                                      IsChecked="{Binding SettingsVM.AutoSyncEnabled}"
                                      Foreground="#CDD6F4"
                                      Margin="0,0,0,8" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ================= TAB 3: APP BLOCKER ================= -->
            <ScrollViewer x:Name="BlockerTabView" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="26,22">
                    <!-- Header -->
                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="App Blocker &amp; Deep Focus"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       Foreground="#FFFFFF" />
                            <TextBlock Text="Safeguard your productivity by blocking distraction apps during Focus Mode sessions"
                                       FontSize="12.5"
                                       Foreground="#60678A"
                                       Margin="0,2,0,0" />
                        </StackPanel>

                        <!-- Focus Mode Toggle Button -->
                        <Button Grid.Column="1"
                                Content="{Binding FocusModeButtonText}"
                                Height="38"
                                Padding="20,0"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Foreground="#FFFFFF"
                                BorderThickness="0"
                                Cursor="Hand"
                                Command="{Binding ToggleFocusModeCommand}">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="#3B82F6" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsFocusModeActive}" Value="True">
                                            <Setter Property="Background" Value="#10B981" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Button.Resources>
                                <Style TargetType="{x:Type Border}">
                                    <Setter Property="CornerRadius" Value="8" />
                                </Style>
                            </Button.Resources>
                        </Button>
                    </Grid>

                    <!-- Active Status & Anti-Cheat Controls Card -->
                    <Border Style="{StaticResource CardPanel}">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="10" Height="10" Margin="0,0,10,0" VerticalAlignment="Center">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="#60678A" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsFocusModeActive}" Value="True">
                                                        <Setter Property="Fill" Value="#10B981" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock Text="{Binding FocusModeStatusText}"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               Foreground="#FFFFFF"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text=" - "
                                               FontSize="14"
                                               Foreground="#60678A"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding AppBlockingStatusText}"
                                               FontSize="13.5"
                                               Foreground="#89B4FA"
                                               VerticalAlignment="Center" />
                                </StackPanel>

                                <!-- Session Block Counter -->
                                <Border Grid.Column="1"
                                        Background="#0E101A"
                                        BorderBrush="#23273D"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="10,4">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding BlockedCountThisSession}"
                                                   FontWeight="Bold"
                                                   Foreground="#FFAA44"
                                                   FontSize="13" />
                                        <TextBlock Text=" launches blocked this session"
                                                   FontSize="12"
                                                   Foreground="#9BA3C7"
                                                   Margin="4,0,8,0" />
                                        <Button Content="Reset"
                                                FontSize="11"
                                                Foreground="#60678A"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Cursor="Hand"
                                                Command="{Binding ResetSessionBlockCountCommand}" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Separator Background="#23273D" Margin="0,0,0,14" />

                            <TextBlock Text="ENFORCEMENT &amp; ANTI-CHEAT RULES"
                                       FontSize="10.5"
                                       FontWeight="Bold"
                                       Foreground="#60678A"
                                       Margin="0,0,0,10" />

                            <CheckBox Content="Enable App Blocking during Focus Mode (Automatically terminates blocked applications while Focus Mode is active)"
                                      IsChecked="{Binding AppBlockingEnabled}"
                                      Foreground="#CDD6F4"
                                      Margin="0,0,0,10" />

                            <CheckBox Content="Block Task Manager in Focus Mode (Prevents opening Windows Task Manager to bypass Focus Mode)"
                                      IsChecked="{Binding BlockTaskManagerInFocus}"
                                      Foreground="#CDD6F4"
                                      Margin="0,0,0,10" />

                            <CheckBox Content="Strict Focus Lock (Requires user confirmation before exiting To-Do while Focus Mode is active)"
                                      IsChecked="{Binding StrictFocusLock}"
                                      Foreground="#CDD6F4"
                                      Margin="0,0,0,4" />
                        </StackPanel>
                    </Border>

                    <!-- Add Applications Card (Drop Zone + Scan + Presets) -->
                    <Border Style="{StaticResource CardPanel}">
                        <StackPanel>
                            <TextBlock Text="Add Applications to Block List"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="#FFFFFF"
                                       Margin="0,0,0,12" />

                            <!-- Drop Zone and Actions Grid -->
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Drop Zone -->
                                <Border Grid.Column="0"
                                        Background="#0E101A"
                                        BorderBrush="#2A304D"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="16"
                                        AllowDrop="True"
                                        Drop="DropZone_Drop"
                                        DragOver="DropZone_DragOver"
                                        Cursor="Hand">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="Drop Application (.exe or .lnk) Here"
                                                   FontSize="13.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="#89B4FA"
                                                   HorizontalAlignment="Center" />
                                        <TextBlock Text="Drag and drop any application executable or desktop shortcut"
                                                   FontSize="11.5"
                                                   Foreground="#60678A"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,3,0,0" />
                                    </StackPanel>
                                </Border>

                                <!-- Action Buttons -->
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Width="200">
                                    <Button Content="Browse Executable..."
                                            Height="34"
                                            Background="#1E2337"
                                            Foreground="#FFFFFF"
                                            BorderBrush="#2E3654"
                                            BorderThickness="1"
                                            FontSize="12"
                                            FontWeight="Medium"
                                            Cursor="Hand"
                                            Click="BrowseApp_Click"
                                            Margin="0,0,0,8">
                                        <Button.Resources>
                                            <Style TargetType="{x:Type Border}">
                                                <Setter Property="CornerRadius" Value="6" />
                                            </Style>
                                        </Button.Resources>
                                    </Button>

                                    <Button Content="Scan Installed Apps"
                                            Height="34"
                                            Background="#252A42"
                                            Foreground="#89B4FA"
                                            BorderBrush="#3B82F6"
                                            BorderThickness="1"
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            Cursor="Hand"
                                            Command="{Binding ScanInstalledAppsCommand}"
                                            IsEnabled="{Binding IsScanningApps, Converter={StaticResource InvBool}}">
                                        <Button.Resources>
                                            <Style TargetType="{x:Type Border}">
                                                <Setter Property="CornerRadius" Value="6" />
                                            </Style>
                                        </Button.Resources>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <!-- Scanning Progress Indicator -->
                            <Border Background="#161928"
                                    BorderBrush="#23273D"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="12,8"
                                    Margin="0,0,0,12"
                                    Visibility="{Binding IsScanningApps, Converter={StaticResource BoolToVis}}">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="Scanning system shortcuts, registry, and running processes..."
                                               FontSize="12"
                                               Foreground="#89B4FA"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <!-- Scanned Apps List (Expandable after scan) -->
                            <StackPanel Visibility="{Binding HasScannedApps, Converter={StaticResource BoolToVis}}" Margin="0,0,0,14">
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="220" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Detected Applications"
                                               FontSize="12.5"
                                               FontWeight="SemiBold"
                                               Foreground="#9BA3C7"
                                               VerticalAlignment="Center" />
                                    <!-- Search input -->
                                    <TextBox Grid.Column="1"
                                             Text="{Binding ScannedSearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                             Height="28"
                                             Background="#0E101A"
                                             Foreground="#FFFFFF"
                                             BorderBrush="#23273D"
                                             BorderThickness="1"
                                             Padding="8,4"
                                             FontSize="11.5"
                                             VerticalContentAlignment="Center">
                                        <TextBox.Resources>
                                            <Style TargetType="{x:Type Border}">
                                                <Setter Property="CornerRadius" Value="6" />
                                            </Style>
                                        </TextBox.Resources>
                                    </TextBox>
                                </Grid>

                                <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding FilteredScannedApps}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#0E101A"
                                                        BorderBrush="#1D2134"
                                                        BorderThickness="1"
                                                        CornerRadius="6"
                                                        Padding="10,6"
                                                        Margin="0,0,0,4">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="28" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <Image Source="{Binding Icon}"
                                                               Width="20"
                                                               Height="20"
                                                               HorizontalAlignment="Left"
                                                               VerticalAlignment="Center" />

                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                                                            <TextBlock Text="{Binding Name}"
                                                                       FontSize="12.5"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="#FFFFFF" />
                                                            <TextBlock Text="{Binding DisplayProcessName}"
                                                                       FontSize="10.5"
                                                                       Foreground="#60678A" />
                                                        </StackPanel>

                                                        <Button Grid.Column="2"
                                                                Content="+ Block"
                                                                Height="26"
                                                                Padding="12,0"
                                                                FontSize="11"
                                                                FontWeight="SemiBold"
                                                                Background="#1C2640"
                                                                Foreground="#89B4FA"
                                                                BorderBrush="#3B82F6"
                                                                BorderThickness="1"
                                                                Cursor="Hand"
                                                                Command="{Binding DataContext.AddBlockedAppCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding}">
                                                            <Button.Resources>
                                                                <Style TargetType="{x:Type Border}">
                                                                    <Setter Property="CornerRadius" Value="4" />
                                                                </Style>
                                                            </Button.Resources>
                                                        </Button>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>

                            <!-- Presets Quick Add -->
                            <TextBlock Text="Popular Distraction Presets (Click to add):"
                                       FontSize="11.5"
                                       Foreground="#60678A"
                                       Margin="0,0,0,8" />

                            <ItemsControl ItemsSource="{Binding DistractionPresets}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding Name, StringFormat='+ {0}'}"
                                                Height="28"
                                                Padding="10,0"
                                                Margin="0,0,6,6"
                                                FontSize="11.5"
                                                Background="#161928"
                                                Foreground="#CDD6F4"
                                                BorderBrush="#23273D"
                                                BorderThickness="1"
                                                Cursor="Hand"
                                                Command="{Binding DataContext.AddBlockedAppCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}">
                                            <Button.Resources>
                                                <Style TargetType="{x:Type Border}">
                                                    <Setter Property="CornerRadius" Value="6" />
                                                </Style>
                                            </Button.Resources>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Blocked Apps List Card -->
                    <Border Style="{StaticResource CardPanel}">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Blocked Applications"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               Foreground="#FFFFFF"
                                               VerticalAlignment="Center" />
                                    <Border Margin="10,0,0,0"
                                            Padding="6,2"
                                            CornerRadius="10"
                                            Background="#23273D"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding BlockedApps.Count}"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   Foreground="#89B4FA" />
                                    </Border>
                                </StackPanel>

                                <Button Grid.Column="1"
                                        Content="Clear All"
                                        Height="26"
                                        Padding="10,0"
                                        FontSize="11"
                                        Background="#281A22"
                                        Foreground="#F38BA8"
                                        BorderBrush="#3D202B"
                                        BorderThickness="1"
                                        Cursor="Hand"
                                        Command="{Binding ClearAllBlockedAppsCommand}">
                                    <Button.Resources>
                                        <Style TargetType="{x:Type Border}">
                                            <Setter Property="CornerRadius" Value="4" />
                                        </Style>
                                    </Button.Resources>
                                </Button>
                            </Grid>

                            <!-- Empty state -->
                            <Border Background="#0E101A"
                                    BorderBrush="#23273D"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="24"
                                    Margin="0,0,0,4">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding BlockedApps.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="No applications currently blocked"
                                               FontSize="13.5"
                                               FontWeight="SemiBold"
                                               Foreground="#CDD6F4"
                                               HorizontalAlignment="Center" />
                                    <TextBlock Text="Click a preset above, scan installed apps, or drop an executable to add apps to your block list."
                                               FontSize="12"
                                               Foreground="#60678A"
                                               HorizontalAlignment="Center"
                                               Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- Blocked items list -->
                            <ItemsControl ItemsSource="{Binding BlockedApps}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#0E101A"
                                                BorderBrush="#23273D"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="12,10"
                                                Margin="0,0,0,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="32" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <Image Source="{Binding Icon}"
                                                       Width="22"
                                                       Height="22"
                                                       HorizontalAlignment="Left"
                                                       VerticalAlignment="Center" />

                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                                                    <TextBlock Text="{Binding Name}"
                                                               FontSize="13"
                                                               FontWeight="SemiBold"
                                                               Foreground="#FFFFFF" />
                                                    <TextBlock Text="{Binding DisplayProcessName}"
                                                               FontSize="11"
                                                               Foreground="#60678A" />
                                                </StackPanel>

                                                <!-- Enabled / Disabled toggle -->
                                                <CheckBox Grid.Column="2"
                                                          Content="Blocked"
                                                          IsChecked="{Binding IsEnabled}"
                                                          Foreground="#CDD6F4"
                                                          FontSize="12"
                                                          VerticalAlignment="Center"
                                                          Margin="0,0,14,0"
                                                          Command="{Binding DataContext.ToggleBlockedAppStatusCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                          CommandParameter="{Binding}" />

                                                <!-- Remove button -->
                                                <Button Grid.Column="3"
                                                        Content="Remove"
                                                        Height="26"
                                                        Padding="10,0"
                                                        FontSize="11"
                                                        Background="#25161C"
                                                        Foreground="#F38BA8"
                                                        BorderBrush="#3D202B"
                                                        BorderThickness="1"
                                                        Cursor="Hand"
                                                        Command="{Binding DataContext.RemoveBlockedAppCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}">
                                                    <Button.Resources>
                                                        <Style TargetType="{x:Type Border}">
                                                            <Setter Property="CornerRadius" Value="4" />
                                                        </Style>
                                                    </Button.Resources>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ================= TAB 4: SETTINGS ================= -->
            <ScrollViewer x:Name="SettingsTabView" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="26,22" DataContext="{Binding SettingsVM}">
                    <TextBlock Text="Application Settings"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="#FFFFFF" />
                    <TextBlock Text="Customize widget appearance, focus timers, and system behavior"
                               FontSize="12.5"
                               Foreground="#60678A"
                               Margin="0,2,0,18" />

                    <!-- Focus Mode Timers Card -->
                    <Border Style="{StaticResource CardPanel}">
                        <StackPanel>
                            <TextBlock Text="Anti-Procrastination &amp; Focus Timers"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="#FFFFFF"
                                       Margin="0,0,0,14" />

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="50" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="2-Minute Kickstart Sprint" Foreground="#CDD6F4" />
                                    <TextBlock Text="Overcomes task initiation friction" FontSize="11" Foreground="#60678A" Margin="0,2,0,0" />
                                </StackPanel>
                                <Slider Grid.Column="1"
                                        Minimum="1"
                                        Maximum="10"
                                        Value="{Binding FocusSprintMinutes}"
                                        VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2"
                                           Text="{Binding FocusSprintMinutes, StringFormat='{}{0} min'}"
                                           Foreground="#89B4FA"
                                           VerticalAlignment="Center"
                                           Margin="8,0,0,0" />
                            </Grid>

                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="50" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Pomodoro Focus Duration" Foreground="#CDD6F4" />
                                    <TextBlock Text="Deep work session interval" FontSize="11" Foreground="#60678A" Margin="0,2,0,0" />
                                </StackPanel>
                                <Slider Grid.Column="1"
                                        Minimum="15"
                                        Maximum="60"
                                        Value="{Binding FocusPomodoroMinutes}"
                                        VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2"
                                           Text="{Binding FocusPomodoroMinutes, StringFormat='{}{0} min'}"
                                           Foreground="#89B4FA"
                                           VerticalAlignment="Center"
                                           Margin="8,0,0,0" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Widget Appearance Card -->
                    <Border Style="{StaticResource CardPanel}">
                        <StackPanel>
                            <TextBlock Text="Widget Appearance"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="#FFFFFF"
                                       Margin="0,0,0,14" />

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="140" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Background Color (#Hex)" VerticalAlignment="Center" Foreground="#9BA3C7" />
                                <TextBox Grid.Column="1"
                                         Text="{Binding WidgetBackgroundColor, UpdateSourceTrigger=PropertyChanged}"
                                         Background="#0E101A"
                                         Foreground="#CDD6F4"
                                         BorderBrush="#23273D"
                                         Padding="8,5" />
                            </Grid>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="140" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Accent Color (#Hex)" VerticalAlignment="Center" Foreground="#9BA3C7" />
                                <TextBox Grid.Column="1"
                                         Text="{Binding AccentColor, UpdateSourceTrigger=PropertyChanged}"
                                         Background="#0E101A"
                                         Foreground="#CDD6F4"
                                         BorderBrush="#23273D"
                                         Padding="8,5" />
                            </Grid>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="50" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Widget Opacity" VerticalAlignment="Center" Foreground="#9BA3C7" />
                                <Slider Grid.Column="1"
                                        Minimum="0.3"
                                        Maximum="1.0"
                                        Value="{Binding WidgetOpacity}"
                                        VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2"
                                           Text="{Binding WidgetOpacity, StringFormat='{}{0:P0}'}"
                                           Foreground="#CDD6F4"
                                           VerticalAlignment="Center"
                                           Margin="8,0,0,0" />
                            </Grid>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="50" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Corner Radius" VerticalAlignment="Center" Foreground="#9BA3C7" />
                                <Slider Grid.Column="1"
                                        Minimum="0"
                                        Maximum="28"
                                        Value="{Binding WidgetCornerRadius}"
                                        VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2"
                                           Text="{Binding WidgetCornerRadius, StringFormat='{}{0:F0}px'}"
                                           Foreground="#CDD6F4"
                                           VerticalAlignment="Center"
                                           Margin="8,0,0,0" />
                            </Grid>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="50" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Widget Width" VerticalAlignment="Center" Foreground="#9BA3C7" />
                                <Slider Grid.Column="1"
                                        Minimum="160"
                                        Maximum="500"
                                        Value="{Binding WidgetWidth}"
                                        VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2"
                                           Text="{Binding WidgetWidth, StringFormat='{}{0:F0}px'}"
                                           Foreground="#CDD6F4"
                                           VerticalAlignment="Center"
                                           Margin="8,0,0,0" />
                            </Grid>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="50" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Widget Height" VerticalAlignment="Center" Foreground="#9BA3C7" />
                                <Slider Grid.Column="1"
                                        Minimum="160"
                                        Maximum="700"
                                        Value="{Binding WidgetHeight}"
                                        VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2"
                                           Text="{Binding WidgetHeight, StringFormat='{}{0:F0}px'}"
                                           Foreground="#CDD6F4"
                                           VerticalAlignment="Center"
                                           Margin="8,0,0,0" />
                            </Grid>

                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="140" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Widget Font Family" VerticalAlignment="Center" Foreground="#9BA3C7" />
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding AvailableFonts}"
                                          SelectedItem="{Binding FontFamily}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Widget Behavior & Placement Card -->
                    <Border Style="{StaticResource CardPanel}">
                        <StackPanel>
                            <TextBlock Text="Widget Behavior &amp; Placement"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="#FFFFFF"
                                       Margin="0,0,0,14" />

                            <TextBlock Text="Placement Mode:" Foreground="#9BA3C7" Margin="0,0,0,8" />
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                <RadioButton Content="Float Always on Top"
                                             IsChecked="{Binding IsFloatOnTop}"
                                             Foreground="#CDD6F4"
                                             Margin="0,0,24,0" />
                                <RadioButton Content="Pin Directly to Desktop (Under Windows)"
                                             IsChecked="{Binding IsPinnedToDesktop}"
                                             Foreground="#CDD6F4" />
                            </StackPanel>

                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="140" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Desktop Position" Foreground="#9BA3C7" />
                                    <TextBlock Text="Screen dock preset or draggable" FontSize="11" Foreground="#60678A" Margin="0,2,0,0" />
                                </StackPanel>
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding AvailableDockPositions}"
                                          SelectedItem="{Binding DockPosition}"
                                          Height="34" />
                            </Grid>

                            <CheckBox Content="Show Desktop Widget"
                                      IsChecked="{Binding WidgetVisible}"
                                      Foreground="#CDD6F4"
                                      Margin="0,0,0,10" />

                            <CheckBox Content="Show Streak Badge on Widget"
                                      IsChecked="{Binding ShowStreakOnWidget}"
                                      Foreground="#CDD6F4" />
                        </StackPanel>
                    </Border>

                    <!-- Reminders & Alerts Card -->
                    <Border Style="{StaticResource CardPanel}">
                        <StackPanel>
                            <TextBlock Text="Reminders &amp; Alerts"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="#FFFFFF"
                                       Margin="0,0,0,14" />

                            <CheckBox Content="Enable Due Date Notifications"
                                      IsChecked="{Binding NotificationsEnabled}"
                                      Foreground="#CDD6F4"
                                      Margin="0,0,0,10" />

                            <CheckBox Content="Play Sound on Notifications"
                                      IsChecked="{Binding NotificationSoundEnabled}"
                                      Foreground="#CDD6F4"
                                      Margin="0,0,0,14" />

                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="140" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Default Snooze Duration" VerticalAlignment="Center" Foreground="#9BA3C7" />
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding SnoozeOptions}"
                                          SelectedItem="{Binding DefaultSnoozeDurationMinutes}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding StringFormat='{}{0} minutes'}" Foreground="#CDD6F4" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </Grid>

                            <TextBlock Text="Reminder Intervals (Minutes before due):"
                                       Foreground="#9BA3C7"
                                       Margin="0,0,0,8" />
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <ItemsControl ItemsSource="{Binding ReminderIntervals}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#1C2033"
                                                    CornerRadius="6"
                                                    Padding="8,4"
                                                    Margin="0,0,8,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding StringFormat='{}{0}m'}"
                                                               Foreground="#CDD6F4"
                                                               FontSize="12" />
                                                    <Button Content="✕"
                                                            Margin="6,0,0,0"
                                                            FontSize="10"
                                                            Padding="0"
                                                            Background="Transparent"
                                                            Foreground="#F38BA8"
                                                            BorderThickness="0"
                                                            Cursor="Hand"
                                                            Command="{Binding DataContext.RemoveReminderCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="Transparent" Padding="2,0">
                                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal">
                                <TextBox Width="80"
                                         Text="{Binding NewReminderMinutes, UpdateSourceTrigger=PropertyChanged}"
                                         Background="#0E101A"
                                         Foreground="#CDD6F4"
                                         BorderBrush="#23273D"
                                         Padding="6,4"
                                         Margin="0,0,8,0" />
                                <Button Content="+ Add Interval"
                                        Padding="12,4"
                                        Background="#1C2033"
                                        Foreground="#CDD6F4"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        Command="{Binding AddReminderCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- System & Startup Card -->
                    <Border Style="{StaticResource CardPanel}">
                        <StackPanel>
                            <TextBlock Text="System &amp; Startup"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="#FFFFFF"
                                       Margin="0,0,0,14" />

                            <CheckBox Content="Launch automatically on Windows startup"
                                      IsChecked="{Binding LaunchOnStartup}"
                                      Foreground="#CDD6F4"
                                      Margin="0,0,0,10" />

                            <CheckBox Content="Start minimized to system tray icon"
                                      IsChecked="{Binding StartMinimized}"
                                      Foreground="#CDD6F4"
                                      Margin="0,0,0,10" />

                            <CheckBox Content="Enable smooth UI animations and effects"
                                      IsChecked="{Binding EnableAnimations}"
                                      Foreground="#CDD6F4"
                                      Margin="0,0,0,14" />

                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="140" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Application Theme" VerticalAlignment="Center" Foreground="#9BA3C7" />
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding AvailableThemes}"
                                          SelectedItem="{Binding Theme}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Updates Card -->
                    <Border Style="{StaticResource CardPanel}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="App Updates &amp; Version"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="#FFFFFF"
                                       Margin="0,0,0,12" />

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Installed Version" Foreground="#9BA3C7" FontSize="12" />
                                    <TextBlock Text="{Binding CurrentVersionText}" Foreground="#FFFFFF" FontSize="14" FontWeight="SemiBold" Margin="0,2,0,0" />
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Content="Check for Updates"
                                        Padding="14,6"
                                        Background="#1C2033"
                                        Foreground="#CDD6F4"
                                        BorderBrush="#23273D"
                                        BorderThickness="1"
                                        Cursor="Hand"
                                        Command="{Binding CheckForUpdatesCommand}">
                                    <Button.Resources>
                                        <Style TargetType="{x:Type Border}">
                                            <Setter Property="CornerRadius" Value="6" />
                                        </Style>
                                    </Button.Resources>
                                </Button>
                            </Grid>

                            <CheckBox Content="Automatically check for updates on startup"
                                      IsChecked="{Binding CheckForUpdatesOnStartup}"
                                      Foreground="#CDD6F4"
                                      Margin="0,0,0,10" />

                            <StackPanel Visibility="{Binding Updater.StatusMessage, Converter={StaticResource StringToVis}}" Margin="0,4,0,0">
                                <TextBlock Text="{Binding Updater.StatusMessage}"
                                           Foreground="#89B4FA"
                                           FontSize="12"
                                           Margin="0,0,0,6" />

                                <ProgressBar Height="6"
                                             Minimum="0"
                                             Maximum="100"
                                             Value="{Binding Updater.DownloadProgress, Mode=OneWay}"
                                             Visibility="{Binding Updater.IsDownloading, Converter={StaticResource BoolToVis}}"
                                             Foreground="#10B981"
                                             Background="#0E101A"
                                             Margin="0,0,0,6" />
                            </StackPanel>

                            <Border Background="#141E2F"
                                    BorderBrush="#3B82F6"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="12,10"
                                    Margin="0,8,0,0"
                                    Visibility="{Binding Updater.HasUpdateAvailable, Converter={StaticResource BoolToVis}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="A new update is available!" FontWeight="SemiBold" Foreground="#89B4FA" FontSize="12.5" />
                                        <TextBlock Text="{Binding Updater.AvailableUpdate.Title}" Foreground="#CDD6F4" FontSize="11.5" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Content="Download &amp; Install Silently"
                                            Background="#10B981"
                                            Foreground="#FFFFFF"
                                            FontWeight="SemiBold"
                                            Padding="14,6"
                                            BorderThickness="0"
                                            Cursor="Hand"
                                            Command="{Binding InstallUpdateCommand}">
                                        <Button.Resources>
                                            <Style TargetType="{x:Type Border}">
                                                <Setter Property="CornerRadius" Value="6" />
                                            </Style>
                                        </Button.Resources>
                                    </Button>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Developer Info Card -->
                    <Border Style="{StaticResource CardPanel}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="About the Developer"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="#FFFFFF"
                                       Margin="0,0,0,10" />

                            <TextBlock TextWrapping="Wrap"
                                       Foreground="#9BA3C7"
                                       FontSize="12.5"
                                       LineHeight="19"
                                       Text="Heyy, I am Kartik and I am just a guy with some what exprience with coading. This is my first time making a full windows app using C#. I made this is app with the sole purpose of killing the procastination, It will remind you to complete task even if you forgot to complete it and started doing something in your PC. Hopefully you find this app helpful" />

                            <Border Margin="0,12,0,0"
                                    HorizontalAlignment="Left"
                                    CornerRadius="6"
                                    Background="#0E101A"
                                    BorderBrush="#23273D"
                                    BorderThickness="1"
                                    Padding="10,6">
                                <TextBlock>
                                    <Run Text="GitHub: " Foreground="#89B4FA" FontWeight="Medium" FontSize="12" />
                                    <Hyperlink NavigateUri="https://github.com/Kartik-048"
                                               RequestNavigate="Hyperlink_RequestNavigate"
                                               Foreground="#3B82F6"
                                               TextDecorations="None">
                                        <Run Text="https://github.com/Kartik-048" />
                                    </Hyperlink>
                                </TextBlock>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Save & Reset Action Bar -->
                    <Grid Margin="0,8,0,24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Content="Save Changes"
                                Height="38"
                                Padding="20,0"
                                FontSize="13.5"
                                FontWeight="SemiBold"
                                Background="#3B82F6"
                                Foreground="#FFFFFF"
                                BorderThickness="0"
                                Cursor="Hand"
                                Command="{Binding SaveCommand}"
                                Margin="0,0,10,0">
                            <Button.Resources>
                                <Style TargetType="{x:Type Border}">
                                    <Setter Property="CornerRadius" Value="8" />
                                </Style>
                            </Button.Resources>
                        </Button>

                        <Button Grid.Column="1"
                                Content="Reset Defaults"
                                Height="38"
                                Padding="16,0"
                                FontSize="13"
                                Background="#1C2033"
                                Foreground="#CDD6F4"
                                BorderThickness="0"
                                Cursor="Hand"
                                Command="{Binding ResetDefaultsCommand}">
                            <Button.Resources>
                                <Style TargetType="{x:Type Border}">
                                    <Setter Property="CornerRadius" Value="8" />
                                </Style>
                            </Button.Resources>
                        </Button>

                        <TextBlock Grid.Column="2"
                                   Text="{Binding StatusMessage}"
                                   Foreground="#10B981"
                                   FontSize="13"
                                   FontWeight="Medium"
                                   VerticalAlignment="Center"
                                   Margin="16,0,0,0" />
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
