<Window x:Class="TodoWidget.Views.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:TodoWidget.Converters"
        xmlns:models="clr-namespace:TodoWidget.Models"
        mc:Ignorable="d"
        Title="To-Do Studio - Workbench &amp; Task Organizer"
        Width="1120"
        Height="740"
        MinWidth="960"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="#0D0F16"
        Foreground="#DDE2F2"
        FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif">

    <Window.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:BooleanToVisibilityConverter x:Key="InvBoolToVis" Invert="True" />
        <converters:StringToVisibilityConverter x:Key="StringToVis" />
        <converters:NullToVisibilityConverter x:Key="NullToVis" />
        <converters:NullToVisibilityConverter x:Key="InvNullToVis" Invert="True" />
        <converters:InverseBooleanConverter x:Key="InvBool" />
        <converters:PriorityToBrushConverter x:Key="PriorityToBrush" />
        <converters:DueDateFormatterConverter x:Key="DueDateFormatter" />
        <converters:StatusToBrushConverter x:Key="StatusToBrush" />
        <converters:StatusToStrikethroughConverter x:Key="StatusToStrikethrough" />
        <converters:StatusToOpacityConverter x:Key="StatusToOpacity" />
        <converters:HexToBrushConverter x:Key="HexToBrush" />

        <!-- Top Header Segmented Navigation Radio Button Style (Inspired by Studio Tabs in CapCut / MS Store) -->
        <Style x:Key="StudioTopNavButton" TargetType="RadioButton">
            <Setter Property="Height" Value="36" />
            <Setter Property="Margin" Value="2,0,2,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#8F98B2" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="TabBorder"
                                CornerRadius="7"
                                Background="{TemplateBinding Background}"
                                Padding="12,0"
                                BorderThickness="1"
                                BorderBrush="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#171C27" />
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#252D3F" />
                                <Setter Property="Foreground" Value="#E2E7F5" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#212838" />
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#3B82F6" />
                                <Setter Property="Foreground" Value="#60A5FA" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Left Navigator Collection Category Button Style -->
        <Style x:Key="NavCategoryButton" TargetType="Button">
            <Setter Property="Height" Value="34" />
            <Setter Property="Margin" Value="0,2,0,2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CatBorder"
                                CornerRadius="6"
                                Background="{TemplateBinding Background}"
                                Padding="10,0">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CatBorder" Property="Background" Value="#181D29" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CatBorder" Property="Background" Value="#202737" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Studio Card Panel Style -->
        <Style x:Key="StudioCard" TargetType="Border">
            <Setter Property="Background" Value="#131722" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="BorderBrush" Value="#202638" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>

        <!-- Studio Sub-Panel Style -->
        <Style x:Key="StudioSubCard" TargetType="Border">
            <Setter Property="Background" Value="#0F121C" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderBrush" Value="#1D2333" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>

        <!-- Primary Accent Button Style (Similar to the prominent Export button in editing apps) -->
        <Style x:Key="StudioPrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="Background" Value="#2563EB" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="PBtnBorder"
                                CornerRadius="7"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PBtnBorder" Property="Background" Value="#3B82F6" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="PBtnBorder" Property="Background" Value="#1D4ED8" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="PBtnBorder" Property="Background" Value="#1E2333" />
                                <Setter Property="Foreground" Value="#55607A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Studio Button Style -->
        <Style x:Key="StudioSecondaryButton" TargetType="Button">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Background" Value="#171C27" />
            <Setter Property="Foreground" Value="#CCD2E3" />
            <Setter Property="BorderBrush" Value="#252D3F" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="SBtnBorder"
                                CornerRadius="6"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SBtnBorder" Property="Background" Value="#22293A" />
                                <Setter TargetName="SBtnBorder" Property="BorderBrush" Value="#3B82F6" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="SBtnBorder" Property="Background" Value="#1E2433" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Danger Button Style -->
        <Style x:Key="StudioDangerButton" TargetType="Button">
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Background" Value="#25161C" />
            <Setter Property="Foreground" Value="#F87171" />
            <Setter Property="BorderBrush" Value="#3D202B" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="DBtnBorder"
                                CornerRadius="6"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="DBtnBorder" Property="Background" Value="#381D26" />
                                <Setter TargetName="DBtnBorder" Property="BorderBrush" Value="#EF4444" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- TOP COMMAND BAR (Row 0) -->
            <RowDefinition Height="54" />
            <!-- MAIN WORKSPACE CONTENT (Row 1) -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ================= ROW 0: TOP STUDIO COMMAND BAR ================= -->
        <Border Grid.Row="0"
                Background="#10131B"
                BorderBrush="#1D2230"
                BorderThickness="0,0,0,1"
                Padding="16,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- Left: Brand / Project Identity -->
                    <ColumnDefinition Width="Auto" />
                    <!-- Center: Segmented Navigation Switcher -->
                    <ColumnDefinition Width="*" />
                    <!-- Right: Utilities, Streak, & Action CTA -->
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left: App Identity & Project Mark -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,18,0">
                    <Border Width="28" Height="28" CornerRadius="6" Background="#2563EB" Margin="0,0,10,0">
                        <TextBlock Text="TD" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="TO-DO STUDIO"
                                   FontSize="13.5"
                                   FontWeight="Bold"
                                   Foreground="#FFFFFF"
                                    />
                        <TextBlock Text="WORKBENCH · v6.0.0"
                                   FontSize="9.5"
                                   FontWeight="Medium"
                                   Foreground="#636D88" />
                    </StackPanel>
                    <Rectangle Width="1" Height="24" Fill="#1E2333" Margin="14,0,14,0" VerticalAlignment="Center" />
                    <TextBlock Text="My Workspace"
                               FontSize="11.5"
                               Foreground="#8EA3D0"
                               VerticalAlignment="Center" />
                </StackPanel>

                <!-- Center: Segmented Navigation Switcher (CapCut & MS Store inspired) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <RadioButton Style="{StaticResource StudioTopNavButton}"
                                 GroupName="TopStudioTabs"
                                 IsChecked="True"
                                 Checked="NavWorkbench_Checked"
                                 x:Name="NavWorkbenchRadio">
                        <TextBlock Text="Tasks" VerticalAlignment="Center" />
                    </RadioButton>

                    <RadioButton Style="{StaticResource StudioTopNavButton}"
                                 GroupName="TopStudioTabs"
                                 Checked="NavFocus_Checked"
                                 x:Name="NavFocusRadio">
                        <TextBlock Text="Focus Studio" VerticalAlignment="Center" />
                    </RadioButton>

                    <RadioButton Style="{StaticResource StudioTopNavButton}"
                                 GroupName="TopStudioTabs"
                                 Checked="NavBlocker_Checked"
                                 x:Name="NavBlockerRadio">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="App Blocker" VerticalAlignment="Center" />
                            <Border Margin="6,0,0,0" Padding="5,1" CornerRadius="5" Background="#1C2230" VerticalAlignment="Center">
                                <TextBlock Text="{Binding BlockedApps.Count, FallbackValue='0'}" FontSize="10" FontWeight="Bold" Foreground="#60A5FA" />
                            </Border>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton Style="{StaticResource StudioTopNavButton}"
                                 GroupName="TopStudioTabs"
                                 Checked="NavAnalytics_Checked"
                                 x:Name="NavAnalyticsRadio">
                        <TextBlock Text="Analytics" VerticalAlignment="Center" />
                    </RadioButton>

                    <RadioButton Style="{StaticResource StudioTopNavButton}"
                                 GroupName="TopStudioTabs"
                                 Checked="NavAccount_Checked"
                                 x:Name="NavAccountRadio">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Cloud Sync" VerticalAlignment="Center" />
                            <Ellipse Width="6" Height="6" Fill="#10B981" Margin="6,0,0,0" VerticalAlignment="Center"
                                     Visibility="{Binding CloudSync.IsConnected, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton Style="{StaticResource StudioTopNavButton}"
                                 GroupName="TopStudioTabs"
                                 Checked="NavSettings_Checked"
                                 x:Name="NavSettingsRadio">
                        <TextBlock Text="Settings" VerticalAlignment="Center" />
                    </RadioButton>
                </StackPanel>

                <!-- Right: Streak counter, Sync status, and Prominent Action Button -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Streak Badge -->
                    <Border Background="#1A1C28"
                            CornerRadius="7"
                            Padding="10,5"
                            Margin="0,0,10,0"
                            BorderBrush="#2C2B3F"
                            BorderThickness="1">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="7" Height="7" Fill="#F59E0B" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding StreakCount}" FontWeight="Bold" FontSize="12.5" Foreground="#F59E0B" />
                            <TextBlock Text=" Days" FontSize="11" Foreground="#9BA3C7" Margin="2,0,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Prominent "+ New Task" Button (Like the Export button in CapCut) -->
                    <Button Style="{StaticResource StudioPrimaryButton}"
                            Content="+ New Task"
                            Command="{Binding AddTaskCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= ROW 1: WORKSPACE VIEWS ================= -->
        <Grid Grid.Row="1" Background="#0A0C12">

            <!-- ================= TAB 0: WORKBENCH (TASKS) ================= -->
            <Grid x:Name="WorkbenchTabView" Visibility="Visible">
                <Grid.ColumnDefinitions>
                    <!-- Col 0: Collections Rail -->
                    <ColumnDefinition Width="220" />
                    <!-- Col 1: Main Canvas & Timeline Dock -->
                    <ColumnDefinition Width="*" />
                    <!-- Col 2: DETAILS Inspector Rail (Collapsible) -->
                    <ColumnDefinition Width="280">
                        <ColumnDefinition.Style>
                            <Style TargetType="ColumnDefinition">
                                <Setter Property="Width" Value="280" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDetailsOpen}" Value="False">
                                        <Setter Property="Width" Value="0" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ColumnDefinition.Style>
                    </ColumnDefinition>
                </Grid.ColumnDefinitions>

                <!-- ================= COL 0: LEFT COLLECTIONS EXPLORER ================= -->
                <Border Grid.Column="0"
                        Background="#0D1017"
                        BorderBrush="#181D29"
                        BorderThickness="0,0,1,0"
                        Padding="12,14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Collections Header -->
                        <TextBlock Grid.Row="0"
                                   Text="COLLECTIONS"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Foreground="#535E7A"
                                   Margin="6,0,0,8" />

                        <!-- Category List -->
                        <StackPanel Grid.Row="1">
                            <Button Style="{StaticResource NavCategoryButton}"
                                    Command="{Binding SetCategoryCommand}"
                                    CommandParameter="All">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="All Tasks" FontSize="12.5" Foreground="#CCD2E3" VerticalAlignment="Center" />
                                    <Border Grid.Column="1" Padding="6,1" CornerRadius="5" Background="#161B26">
                                        <TextBlock Text="{Binding CountAll}" FontSize="10.5" FontWeight="SemiBold" Foreground="#8EA3D0" />
                                    </Border>
                                </Grid>
                            </Button>

                            <Button Style="{StaticResource NavCategoryButton}"
                                    Command="{Binding SetCategoryCommand}"
                                    CommandParameter="Today">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Today's Schedule" FontSize="12.5" Foreground="#CCD2E3" VerticalAlignment="Center" />
                                    <Border Grid.Column="1" Padding="6,1" CornerRadius="5" Background="#161B26">
                                        <TextBlock Text="{Binding CountToday}" FontSize="10.5" FontWeight="SemiBold" Foreground="#60A5FA" />
                                    </Border>
                                </Grid>
                            </Button>

                            <Button Style="{StaticResource NavCategoryButton}"
                                    Command="{Binding SetCategoryCommand}"
                                    CommandParameter="Upcoming">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Due Soon (48h)" FontSize="12.5" Foreground="#CCD2E3" VerticalAlignment="Center" />
                                    <Border Grid.Column="1" Padding="6,1" CornerRadius="5" Background="#161B26">
                                        <TextBlock Text="{Binding CountUpcoming}" FontSize="10.5" FontWeight="SemiBold" Foreground="#8EA3D0" />
                                    </Border>
                                </Grid>
                            </Button>

                            <Button Style="{StaticResource NavCategoryButton}"
                                    Command="{Binding SetCategoryCommand}"
                                    CommandParameter="HighPriority">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Width="6" Height="6" Fill="#F87171" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock Text="High Priority" FontSize="12.5" Foreground="#CCD2E3" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Padding="6,1" CornerRadius="5" Background="#26171D">
                                        <TextBlock Text="{Binding CountHighPriority}" FontSize="10.5" FontWeight="SemiBold" Foreground="#F87171" />
                                    </Border>
                                </Grid>
                            </Button>

                            <Button Style="{StaticResource NavCategoryButton}"
                                    Command="{Binding SetCategoryCommand}"
                                    CommandParameter="VoiceNotes">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Voice Memos" FontSize="12.5" Foreground="#CCD2E3" VerticalAlignment="Center" />
                                    <Border Grid.Column="1" Padding="6,1" CornerRadius="5" Background="#161B26">
                                        <TextBlock Text="{Binding CountVoiceNotes}" FontSize="10.5" FontWeight="SemiBold" Foreground="#10B981" />
                                    </Border>
                                </Grid>
                            </Button>

                            <Button Style="{StaticResource NavCategoryButton}"
                                    Command="{Binding SetCategoryCommand}"
                                    CommandParameter="Completed">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Completed Archive" FontSize="12.5" Foreground="#8F98B2" VerticalAlignment="Center" />
                                    <Border Grid.Column="1" Padding="6,1" CornerRadius="5" Background="#161B26">
                                        <TextBlock Text="{Binding CountCompleted}" FontSize="10.5" FontWeight="SemiBold" Foreground="#6B7280" />
                                    </Border>
                                </Grid>
                            </Button>

                            <!-- Priority Legend -->
                            <Separator Background="#181D29" Margin="0,12,0,12" />

                            <TextBlock Text="PRIORITY LEVELS"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="#535E7A"
                                       Margin="6,0,0,8" />

                            <StackPanel Margin="6,0,0,0">
                                <StackPanel Orientation="Horizontal" Margin="0,3">
                                    <Ellipse Width="6" Height="6" Fill="#EF4444" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="High / Urgent" FontSize="11.5" Foreground="#9BA3C7" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,3">
                                    <Ellipse Width="6" Height="6" Fill="#F59E0B" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Medium" FontSize="11.5" Foreground="#9BA3C7" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,3">
                                    <Ellipse Width="6" Height="6" Fill="#10B981" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Low" FontSize="11.5" Foreground="#9BA3C7" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>

                        <!-- Bottom Sync Card -->
                        <Border Grid.Row="2"
                                Background="#121520"
                                CornerRadius="8"
                                Padding="10,8"
                                BorderBrush="#1C2130"
                                BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="CLOUD SYNC" FontSize="9.5" FontWeight="Bold" Foreground="#55607A" />
                                    <TextBlock Text="{Binding CloudSync.Username, FallbackValue='Local Mode'}"
                                               FontSize="11.5"
                                               FontWeight="SemiBold"
                                               Foreground="#8EA3D0"
                                               Margin="0,1,0,0" />
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Content="Sync"
                                        Height="24"
                                        Padding="8,0"
                                        FontSize="10.5"
                                        FontWeight="SemiBold"
                                        Background="#1C2233"
                                        Foreground="#60A5FA"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        Command="{Binding SyncNowCommand}">
                                    <Button.Resources>
                                        <Style TargetType="{x:Type Border}">
                                            <Setter Property="CornerRadius" Value="4" />
                                        </Style>
                                    </Button.Resources>
                                </Button>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- ================= COL 1: TASK CANVAS & TIMELINE DOCK ================= -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <!-- Upper Action Toolbar -->
                        <RowDefinition Height="46" />
                        <!-- Main Tasks Deck -->
                        <RowDefinition Height="*" />
                        <!-- Lower Dock: Timeline / Focus Bar (CapCut style) -->
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Upper Action Toolbar -->
                    <Border Grid.Row="0"
                            Background="#0C0E15"
                            BorderBrush="#181D29"
                            BorderThickness="0,0,0,1"
                            Padding="16,0">
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <!-- Search Input -->
                                <ColumnDefinition Width="260" />
                                <!-- Filter Chips -->
                                <ColumnDefinition Width="*" />
                                <!-- View / Details Toggle -->
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Instant Search Box -->
                            <Border Grid.Column="0"
                                    Background="#131722"
                                    BorderBrush="#202638"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Height="30">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="26" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Q"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="#55607A"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                    <TextBox Grid.Column="1"
                                             Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Foreground="#FFFFFF"
                                             FontSize="12"
                                             VerticalContentAlignment="Center"
                                             Padding="2,0,8,0" />
                                </Grid>
                            </Border>

                            <!-- Priority Filter Chips -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Priority:" FontSize="11.5" Foreground="#55607A" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <ComboBox SelectedIndex="0"
                                          Height="28"
                                          Width="90"
                                          Background="#131722"
                                          Foreground="#CCD2E3"
                                          BorderBrush="#202638"
                                          BorderThickness="1"
                                          FontSize="11.5"
                                          SelectionChanged="StatusFilterCombo_SelectionChanged"
                                          x:Name="StatusFilterCombo">
                                    <ComboBoxItem Content="All Status" />
                                    <ComboBoxItem Content="Pending" />
                                    <ComboBoxItem Content="Completed" />
                                    <ComboBoxItem Content="Failed" />
                                </ComboBox>
                            </StackPanel>

                            <!-- Right: Inspector Toggle Button -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="Details Panel"
                                        Height="28"
                                        Padding="10,0"
                                        FontSize="11.5"
                                        FontWeight="Medium"
                                        Background="#171C27"
                                        Foreground="#8EA3D0"
                                        BorderBrush="#252D3F"
                                        BorderThickness="1"
                                        Cursor="Hand"
                                        Command="{Binding ToggleDetailsCommand}">
                                    <Button.Resources>
                                        <Style TargetType="{x:Type Border}">
                                            <Setter Property="CornerRadius" Value="5" />
                                        </Style>
                                    </Button.Resources>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Main Tasks Canvas -->
                    <Grid Grid.Row="1" Margin="16,12,16,8">
                        <!-- Empty Collection State -->
                        <Border Background="#10131C"
                                BorderBrush="#1C212F"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="32"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding FilteredTasks.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="No tasks found in this view"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="#CCD2E3"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="Create a task with '+ New Task' above or the quick dock below"
                                           FontSize="12"
                                           Foreground="#55607A"
                                           HorizontalAlignment="Center"
                                           Margin="0,4,0,12" />
                                <Button Style="{StaticResource StudioPrimaryButton}"
                                        Content="+ Add Your First Task"
                                        HorizontalAlignment="Center"
                                        Command="{Binding AddTaskCommand}" />
                            </StackPanel>
                        </Border>

                        <!-- Virtualized Task ListBox (Smooth, High Performance) -->
                        <ListBox ItemsSource="{Binding FilteredTasks}"
                                 SelectedItem="{Binding SelectedTask, Mode=TwoWay}"
                                 SelectionChanged="TaskList_SelectionChanged"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0,0,0,6" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <ContentPresenter />
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#121622"
                                            BorderBrush="#1E2436"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="12,10"
                                            Cursor="Hand"
                                            MouseLeftButtonUp="TaskRow_MouseDoubleClick">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#171C2B" />
                                                        <Setter Property="BorderBrush" Value="#3B82F6" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <!-- Priority Indicator Bar -->
                                                <ColumnDefinition Width="6" />
                                                <!-- Status Checkbox -->
                                                <ColumnDefinition Width="26" />
                                                <!-- Task Title & Snippet -->
                                                <ColumnDefinition Width="*" />
                                                <!-- Time & Voice Badges -->
                                                <ColumnDefinition Width="Auto" />
                                                <!-- Actions -->
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Left Priority Stripe -->
                                            <Border Grid.Column="0"
                                                    Width="3"
                                                    CornerRadius="2"
                                                    Background="{Binding Priority, Converter={StaticResource PriorityToBrush}}"
                                                    HorizontalAlignment="Left"
                                                    Margin="0,2,0,2" />

                                            <!-- Status Checkbox -->
                                            <Button Grid.Column="1"
                                                    Width="18"
                                                    Height="18"
                                                    VerticalAlignment="Center"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Cursor="Hand"
                                                    Command="{Binding DataContext.ToggleTaskStatusCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                    CommandParameter="{Binding}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="CbBorder"
                                                                CornerRadius="4"
                                                                Background="#161B28"
                                                                BorderBrush="#2C354C"
                                                                BorderThickness="1.5">
                                                            <TextBlock x:Name="CheckIcon"
                                                                       Text="OK"
                                                                       FontSize="8"
                                                                       FontWeight="Bold"
                                                                       Foreground="#10B981"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"
                                                                       Visibility="Collapsed" />
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Completed">
                                                                <Setter TargetName="CheckIcon" Property="Visibility" Value="Visible" />
                                                                <Setter TargetName="CbBorder" Property="Background" Value="#0F241C" />
                                                                <Setter TargetName="CbBorder" Property="BorderBrush" Value="#10B981" />
                                                            </DataTrigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>

                                            <!-- Task Content -->
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="8,0,10,0">
                                                <TextBlock Text="{Binding Title}"
                                                           FontSize="13"
                                                           FontWeight="SemiBold"
                                                           Foreground="#FFFFFF"
                                                           TextTrimming="CharacterEllipsis"
                                                           TextDecorations="{Binding Status, Converter={StaticResource StatusToStrikethrough}}"
                                                           Opacity="{Binding Status, Converter={StaticResource StatusToOpacity}}" />
                                                <TextBlock Text="{Binding Description}"
                                                           FontSize="11"
                                                           Foreground="#636D88"
                                                           TextTrimming="CharacterEllipsis"
                                                           Margin="0,2,0,0"
                                                           Visibility="{Binding Description, Converter={StaticResource StringToVis}}" />
                                            </StackPanel>

                                            <!-- Deadline & Audio Pill Badges -->
                                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                                                <!-- Voice Memo Pill -->
                                                <Border Background="#14231E"
                                                        BorderBrush="#1C4033"
                                                        BorderThickness="1"
                                                        CornerRadius="5"
                                                        Padding="6,2"
                                                        Margin="0,0,6,0"
                                                        Visibility="{Binding HasVoiceNote, Converter={StaticResource BoolToVis}}">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Button Content="PLAY"
                                                                FontSize="9"
                                                                FontWeight="Bold"
                                                                Foreground="#10B981"
                                                                Background="Transparent"
                                                                BorderThickness="0"
                                                                Cursor="Hand"
                                                                Command="{Binding DataContext.ToggleVoiceNoteCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                                CommandParameter="{Binding}" />
                                                        <TextBlock Text="{Binding VoiceNoteDurationText}"
                                                                   FontSize="10"
                                                                   Foreground="#86EFAC"
                                                                   Margin="4,0,0,0" />
                                                    </StackPanel>
                                                </Border>

                                                <!-- Due Date Badge -->
                                                <Border Background="#161B28"
                                                        BorderBrush="#252E44"
                                                        BorderThickness="1"
                                                        CornerRadius="5"
                                                        Padding="8,2"
                                                        Visibility="{Binding EffectiveDueDate, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="{Binding EffectiveDueDate, Converter={StaticResource DueDateFormatter}}"
                                                               FontSize="10.5"
                                                               FontWeight="Medium"
                                                               Foreground="#8EA3D0" />
                                                </Border>
                                            </StackPanel>

                                            <!-- Action Buttons -->
                                            <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Content="Edit"
                                                        Height="26"
                                                        Padding="8,0"
                                                        FontSize="11"
                                                        Background="#181D29"
                                                        Foreground="#8EA3D0"
                                                        BorderBrush="#252D3F"
                                                        BorderThickness="1"
                                                        Cursor="Hand"
                                                        Margin="0,0,4,0"
                                                        Command="{Binding DataContext.EditTaskCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                        CommandParameter="{Binding}">
                                                    <Button.Resources>
                                                        <Style TargetType="{x:Type Border}">
                                                            <Setter Property="CornerRadius" Value="4" />
                                                        </Style>
                                                    </Button.Resources>
                                                </Button>

                                                <Button Content="Del"
                                                        Height="26"
                                                        Padding="8,0"
                                                        FontSize="11"
                                                        Background="#25161C"
                                                        Foreground="#F87171"
                                                        BorderBrush="#3D202B"
                                                        BorderThickness="1"
                                                        Cursor="Hand"
                                                        Command="{Binding DataContext.DeleteTaskCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                        CommandParameter="{Binding}">
                                                    <Button.Resources>
                                                        <Style TargetType="{x:Type Border}">
                                                            <Setter Property="CornerRadius" Value="4" />
                                                        </Style>
                                                    </Button.Resources>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>

                    <!-- ================= LOWER DOCK: TIMELINE, FOCUS KICKSTART, & QUICK INPUT ================= -->
                    <Border Grid.Row="2"
                            Background="#0E111A"
                            BorderBrush="#181D29"
                            BorderThickness="0,1,0,0"
                            Padding="16,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <!-- Daily Progress Gauge (Left) -->
                                <ColumnDefinition Width="220" />
                                <!-- Focus Pod (Center) -->
                                <ColumnDefinition Width="*" />
                                <!-- Quick Task Entry (Right) -->
                                <ColumnDefinition Width="340" />
                            </Grid.ColumnDefinitions>

                            <!-- Daily Progress Meter -->
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="DAILY COMPLETION" FontSize="9.5" FontWeight="Bold" Foreground="#55607A" />
                                    <TextBlock Grid.Column="1" Text="{Binding DailyProgressFractionText}" FontSize="11" Foreground="#8EA3D0" />
                                </Grid>
                                <ProgressBar Height="6"
                                             Value="{Binding DailyProgressPercentage}"
                                             Maximum="100"
                                             Background="#181D29"
                                             Foreground="#10B981"
                                             BorderThickness="0">
                                    <ProgressBar.Resources>
                                        <Style TargetType="{x:Type Border}">
                                            <Setter Property="CornerRadius" Value="3" />
                                        </Style>
                                    </ProgressBar.Resources>
                                </ProgressBar>
                            </StackPanel>

                            <!-- Center: Focus Sprint Kickstart Pod -->
                            <Border Grid.Column="1"
                                    Background="#121622"
                                    BorderBrush="#1E2536"
                                    BorderThickness="1"
                                    CornerRadius="7"
                                    Padding="10,6"
                                    Margin="14,0"
                                    VerticalAlignment="Center">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <!-- Mode Toggle -->
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="2m"
                                                Height="24"
                                                Padding="6,0"
                                                FontSize="10.5"
                                                FontWeight="Bold"
                                                Background="#1B2232"
                                                Foreground="#60A5FA"
                                                BorderThickness="0"
                                                Cursor="Hand"
                                                Margin="0,0,4,0"
                                                Command="{Binding SetDockTimerModeCommand}"
                                                CommandParameter="Sprint" />
                                        <Button Content="25m"
                                                Height="24"
                                                Padding="6,0"
                                                FontSize="10.5"
                                                FontWeight="Bold"
                                                Background="#1B2232"
                                                Foreground="#8EA3D0"
                                                BorderThickness="0"
                                                Cursor="Hand"
                                                Command="{Binding SetDockTimerModeCommand}"
                                                CommandParameter="Pomodoro" />
                                    </StackPanel>

                                    <!-- Timer Digits -->
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding DockTimerDisplay}"
                                               FontSize="16"
                                               FontWeight="Bold"
                                               Foreground="#FFFFFF"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />

                                    <!-- Controls -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="START / PAUSE"
                                                Height="24"
                                                Padding="8,0"
                                                FontSize="10.5"
                                                FontWeight="Bold"
                                                Background="#2563EB"
                                                Foreground="#FFFFFF"
                                                BorderThickness="0"
                                                Cursor="Hand"
                                                Margin="0,0,4,0"
                                                Command="{Binding ToggleDockTimerCommand}">
                                            <Button.Resources>
                                                <Style TargetType="{x:Type Border}">
                                                    <Setter Property="CornerRadius" Value="4" />
                                                </Style>
                                            </Button.Resources>
                                        </Button>
                                        <Button Content="RESET"
                                                Height="24"
                                                Padding="6,0"
                                                FontSize="10.5"
                                                FontWeight="SemiBold"
                                                Background="#181D29"
                                                Foreground="#8EA3D0"
                                                BorderThickness="0"
                                                Cursor="Hand"
                                                Command="{Binding ResetDockTimerCommand}">
                                            <Button.Resources>
                                                <Style TargetType="{x:Type Border}">
                                                    <Setter Property="CornerRadius" Value="4" />
                                                </Style>
                                            </Button.Resources>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Right: Quick-Add Input Bar -->
                            <Grid Grid.Column="2" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding QuickAddTitle, UpdateSourceTrigger=PropertyChanged}"
                                         KeyDown="QuickAddTextBox_KeyDown"
                                         Height="30"
                                         Background="#131722"
                                         Foreground="#FFFFFF"
                                         BorderBrush="#202638"
                                         BorderThickness="1"
                                         Padding="8,4"
                                         FontSize="12"
                                         VerticalContentAlignment="Center"
                                         Margin="0,0,6,0">
                                    <TextBox.Resources>
                                        <Style TargetType="{x:Type Border}">
                                            <Setter Property="CornerRadius" Value="6" />
                                        </Style>
                                    </TextBox.Resources>
                                </TextBox>
                                <Button Grid.Column="1"
                                        Content="+ Add"
                                        Height="30"
                                        Padding="12,0"
                                        FontSize="11.5"
                                        FontWeight="SemiBold"
                                        Background="#1C2333"
                                        Foreground="#60A5FA"
                                        BorderBrush="#2E3952"
                                        BorderThickness="1"
                                        Cursor="Hand"
                                        Command="{Binding QuickAddTaskCommand}">
                                    <Button.Resources>
                                        <Style TargetType="{x:Type Border}">
                                            <Setter Property="CornerRadius" Value="6" />
                                        </Style>
                                    </Button.Resources>
                                </Button>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ================= COL 2: "DETAILS" INSPECTOR RAIL (CapCut style) ================= -->
                <Border Grid.Column="2"
                        Background="#0D1017"
                        BorderBrush="#181D29"
                        BorderThickness="1,0,0,0"
                        Padding="16,14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <!-- Header -->
                            <RowDefinition Height="Auto" />
                            <!-- Content Details Scroll -->
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Grid Grid.Row="0" Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="DETAILS"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="#8EA3D0"
                                       VerticalAlignment="Center" />
                            <Button Grid.Column="1"
                                    Content="X"
                                    Height="20"
                                    Width="20"
                                    FontSize="10"
                                    FontWeight="Bold"
                                    Background="Transparent"
                                    Foreground="#55607A"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Command="{Binding ToggleDetailsCommand}" />
                        </Grid>

                        <!-- Selected Task Content Details -->
                        <ScrollViewer Grid.Row="1"
                                      VerticalScrollBarVisibility="Auto"
                                      Visibility="{Binding IsTaskSelected, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <!-- Task Title & Status Toggle -->
                                <Border Style="{StaticResource StudioSubCard}">
                                    <StackPanel>
                                        <TextBlock Text="TASK TITLE" FontSize="9.5" FontWeight="Bold" Foreground="#55607A" />
                                        <TextBlock Text="{Binding SelectedTask.Title}"
                                                   FontSize="14"
                                                   FontWeight="Bold"
                                                   Foreground="#FFFFFF"
                                                   TextWrapping="Wrap"
                                                   Margin="0,4,0,10" />

                                        <Button Content="{Binding SelectedTask.Status, StringFormat='Status: {0} (Click to toggle)'}"
                                                Height="30"
                                                FontSize="11.5"
                                                FontWeight="SemiBold"
                                                Background="#171C27"
                                                Foreground="#60A5FA"
                                                BorderBrush="#252D3F"
                                                BorderThickness="1"
                                                Cursor="Hand"
                                                Command="{Binding ToggleSelectedTaskStatusCommand}">
                                            <Button.Resources>
                                                <Style TargetType="{x:Type Border}">
                                                    <Setter Property="CornerRadius" Value="6" />
                                                </Style>
                                            </Button.Resources>
                                        </Button>
                                    </StackPanel>
                                </Border>

                                <!-- Description -->
                                <Border Style="{StaticResource StudioSubCard}"
                                        Visibility="{Binding SelectedTask.Description, Converter={StaticResource StringToVis}}">
                                    <StackPanel>
                                        <TextBlock Text="DESCRIPTION" FontSize="9.5" FontWeight="Bold" Foreground="#55607A" />
                                        <TextBlock Text="{Binding SelectedTask.Description}"
                                                   FontSize="12"
                                                   Foreground="#CCD2E3"
                                                   TextWrapping="Wrap"
                                                   Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>

                                <!-- Schedule & Deadline -->
                                <Border Style="{StaticResource StudioSubCard}">
                                    <StackPanel>
                                        <TextBlock Text="SCHEDULE &amp; DEADLINE" FontSize="9.5" FontWeight="Bold" Foreground="#55607A" />
                                        <TextBlock Text="{Binding SelectedTask.EffectiveDueDate, Converter={StaticResource DueDateFormatter}, FallbackValue='No deadline set'}"
                                                   FontSize="12.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="#60A5FA"
                                                   Margin="0,4,0,4" />
                                        <TextBlock Text="{Binding SelectedTask.RecurringDaysSummary}"
                                                   FontSize="11"
                                                   Foreground="#8EA3D0"
                                                   Visibility="{Binding SelectedTask.IsRecurring, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                </Border>

                                <!-- Audio Memo -->
                                <Border Style="{StaticResource StudioSubCard}"
                                        Visibility="{Binding SelectedTask.HasVoiceNote, Converter={StaticResource BoolToVis}}">
                                    <StackPanel>
                                        <TextBlock Text="VOICE MEMO" FontSize="9.5" FontWeight="Bold" Foreground="#55607A" />
                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                            <Button Content="Play Memo"
                                                    Height="26"
                                                    Padding="10,0"
                                                    FontSize="11"
                                                    FontWeight="SemiBold"
                                                    Background="#10251E"
                                                    Foreground="#86EFAC"
                                                    BorderBrush="#194838"
                                                    BorderThickness="1"
                                                    Cursor="Hand"
                                                    Command="{Binding ToggleVoiceNoteCommand}"
                                                    CommandParameter="{Binding SelectedTask}">
                                                <Button.Resources>
                                                    <Style TargetType="{x:Type Border}">
                                                        <Setter Property="CornerRadius" Value="4" />
                                                    </Style>
                                                </Button.Resources>
                                            </Button>
                                            <TextBlock Text="{Binding SelectedTask.VoiceNoteDurationText, StringFormat='Duration: {0}'}"
                                                       FontSize="11"
                                                       Foreground="#8EA3D0"
                                                       VerticalAlignment="Center"
                                                       Margin="8,0,0,0" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Timestamps -->
                                <Border Style="{StaticResource StudioSubCard}">
                                    <StackPanel>
                                        <TextBlock Text="TIMESTAMPS" FontSize="9.5" FontWeight="Bold" Foreground="#55607A" Margin="0,0,0,4" />
                                        <TextBlock Text="{Binding SelectedTask.CreatedAt, StringFormat='Created: {0:MMM dd, yyyy h:mm tt}'}" FontSize="11" Foreground="#636D88" />
                                        <TextBlock Text="{Binding SelectedTask.UpdatedAt, StringFormat='Updated: {0:MMM dd, yyyy h:mm tt}'}" FontSize="11" Foreground="#636D88" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Border>

                                <!-- Inspector Actions -->
                                <StackPanel Margin="0,6,0,0">
                                    <Button Style="{StaticResource StudioSecondaryButton}"
                                            Content="Edit Full Task Details..."
                                            Height="32"
                                            Margin="0,0,0,6"
                                            Command="{Binding EditSelectedTaskCommand}" />

                                    <Button Style="{StaticResource StudioSecondaryButton}"
                                            Content="Snooze 15 Minutes"
                                            Height="32"
                                            Margin="0,0,0,6"
                                            Command="{Binding SnoozeSelectedTaskCommand}" />

                                    <Button Style="{StaticResource StudioDangerButton}"
                                            Content="Delete Task"
                                            Height="32"
                                            Command="{Binding DeleteSelectedTaskCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Workspace Placeholder when no task selected -->
                        <ScrollViewer Grid.Row="1"
                                      VerticalScrollBarVisibility="Auto"
                                      Visibility="{Binding IsTaskSelected, Converter={StaticResource InvBoolToVis}}">
                            <StackPanel>
                                <Border Style="{StaticResource StudioSubCard}">
                                    <StackPanel>
                                        <TextBlock Text="WORKSPACE OVERVIEW" FontSize="10" FontWeight="Bold" Foreground="#55607A" Margin="0,0,0,6" />
                                        <TextBlock Text="Select any task in the workbench to inspect attributes, schedule rules, voice recordings, and actions."
                                                   FontSize="12"
                                                   Foreground="#8EA3D0"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource StudioSubCard}">
                                    <StackPanel>
                                        <TextBlock Text="QUICK TELEMETRY" FontSize="10" FontWeight="Bold" Foreground="#55607A" Margin="0,0,0,8" />
                                        <Grid Margin="0,2">
                                            <TextBlock Text="Total Tasks" FontSize="12" Foreground="#8EA3D0" />
                                            <TextBlock Text="{Binding TotalTasks}" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Right" />
                                        </Grid>
                                        <Grid Margin="0,2">
                                            <TextBlock Text="Pending" FontSize="12" Foreground="#8EA3D0" />
                                            <TextBlock Text="{Binding PendingCount}" FontSize="12" FontWeight="Bold" Foreground="#60A5FA" HorizontalAlignment="Right" />
                                        </Grid>
                                        <Grid Margin="0,2">
                                            <TextBlock Text="Completed Today" FontSize="12" Foreground="#8EA3D0" />
                                            <TextBlock Text="{Binding CompletedToday}" FontSize="12" FontWeight="Bold" Foreground="#10B981" HorizontalAlignment="Right" />
                                        </Grid>
                                        <Grid Margin="0,2">
                                            <TextBlock Text="Current Streak" FontSize="12" Foreground="#8EA3D0" />
                                            <TextBlock Text="{Binding StreakCount, StringFormat='{}{0} Days'}" FontSize="12" FontWeight="Bold" Foreground="#F59E0B" HorizontalAlignment="Right" />
                                        </Grid>
                                        <Grid Margin="0,2">
                                            <TextBlock Text="Completion Rate" FontSize="12" Foreground="#8EA3D0" />
                                            <TextBlock Text="{Binding CompletionRate, StringFormat='{}{0}%'}" FontSize="12" FontWeight="Bold" Foreground="#10B981" HorizontalAlignment="Right" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <!-- ================= TAB 1: FOCUS STUDIO ================= -->
            <ScrollViewer x:Name="FocusRoomTabView" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="32,24" MaxWidth="800" HorizontalAlignment="Center">
                    <TextBlock Text="Focus Studio" FontSize="24" FontWeight="Bold" Foreground="#FFFFFF" />
                    <TextBlock Text="Deep work chamber engineered to eliminate distractions and build execution momentum"
                               FontSize="13" Foreground="#636D88" Margin="0,3,0,20" />

                    <!-- Main Focus Pod Card -->
                    <Border Style="{StaticResource StudioCard}" Padding="28">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="{Binding FocusModeStatusText}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="#60A5FA"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,10" />

                            <TextBlock Text="{Binding DockTimerDisplay}"
                                       FontSize="56"
                                       FontWeight="Bold"
                                       Foreground="#FFFFFF"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,18" />

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20">
                                <Button Style="{StaticResource StudioPrimaryButton}"
                                        Content="{Binding FocusModeButtonText}"
                                        Height="40"
                                        Padding="24,0"
                                        Margin="0,0,10,0"
                                        Command="{Binding ToggleFocusModeCommand}" />

                                <Button Style="{StaticResource StudioSecondaryButton}"
                                        Content="Reset Timer"
                                        Height="40"
                                        Padding="18,0"
                                        Command="{Binding ResetDockTimerCommand}" />
                            </StackPanel>

                            <Border Background="#0D1017" BorderBrush="#1C2130" BorderThickness="1" CornerRadius="8" Padding="14,10" Width="440">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="APP BLOCKER STATUS" FontSize="9.5" FontWeight="Bold" Foreground="#55607A" />
                                        <TextBlock Text="{Binding AppBlockingStatusText}" FontSize="12.5" FontWeight="SemiBold" Foreground="#10B981" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding BlockedCountThisSession, StringFormat='{}{0} Intercepted'}"
                                               FontSize="12"
                                               FontWeight="Bold"
                                               Foreground="#F59E0B"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ================= TAB 2: APP BLOCKER ================= -->
            <ScrollViewer x:Name="BlockerTabView" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="32,24" MaxWidth="920">
                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="App Blocker &amp; Distraction Radar" FontSize="24" FontWeight="Bold" Foreground="#FFFFFF" />
                            <TextBlock Text="Safeguard your deep focus sessions by terminating configured distraction apps immediately"
                                       FontSize="13" Foreground="#636D88" Margin="0,3,0,0" />
                        </StackPanel>

                        <Button Grid.Column="1"
                                Style="{StaticResource StudioPrimaryButton}"
                                Content="{Binding FocusModeButtonText}"
                                Command="{Binding ToggleFocusModeCommand}" />
                    </Grid>

                    <!-- Anti-Cheat Enforcement Controls -->
                    <Border Style="{StaticResource StudioCard}">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="ENFORCEMENT RULES" FontSize="11" FontWeight="Bold" Foreground="#60A5FA" />
                                    <TextBlock Text=" · Anti-Cheat Shield" FontSize="11" Foreground="#55607A" />
                                </StackPanel>
                                <Border Grid.Column="1" Background="#0D1017" CornerRadius="6" Padding="10,4" BorderBrush="#1C2130" BorderThickness="1">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding BlockedCountThisSession}" FontWeight="Bold" Foreground="#F59E0B" FontSize="12.5" />
                                        <TextBlock Text=" apps blocked this session" FontSize="11.5" Foreground="#8EA3D0" Margin="4,0,8,0" />
                                        <Button Content="Reset" FontSize="11" Foreground="#55607A" Background="Transparent" BorderThickness="0" Cursor="Hand" Command="{Binding ResetSessionBlockCountCommand}" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <CheckBox Content="Enable App Blocking during Focus Mode (Automatically terminates blocked processes while Focus Mode is active)"
                                      IsChecked="{Binding AppBlockingEnabled}"
                                      Foreground="#CCD2E3"
                                      FontSize="12.5"
                                      Margin="0,0,0,8" />

                            <CheckBox Content="Block Task Manager in Focus Mode (Prevents opening Windows Task Manager to bypass Focus Mode)"
                                      IsChecked="{Binding BlockTaskManagerInFocus}"
                                      Foreground="#CCD2E3"
                                      FontSize="12.5"
                                      Margin="0,0,0,8" />

                            <CheckBox Content="Strict Focus Lock (Requires user confirmation before exiting To-Do while Focus Mode is active)"
                                      IsChecked="{Binding StrictFocusLock}"
                                      Foreground="#CCD2E3"
                                      FontSize="12.5" />
                        </StackPanel>
                    </Border>

                    <!-- Add Applications Card (Drop Zone + Scan + Presets) -->
                    <Border Style="{StaticResource StudioCard}">
                        <StackPanel>
                            <TextBlock Text="ADD APPLICATIONS TO BLOCK LIST" FontSize="11" FontWeight="Bold" Foreground="#55607A" Margin="0,0,0,12" />

                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="200" />
                                </Grid.ColumnDefinitions>

                                <!-- Drop Target -->
                                <Border Grid.Column="0"
                                        Background="#0D1017"
                                        BorderBrush="#1E2436"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="16"
                                        AllowDrop="True"
                                        Drop="DropZone_Drop"
                                        DragOver="DropZone_DragOver"
                                        Cursor="Hand">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="Drop Executable (.exe or .lnk) Here"
                                                   FontSize="13.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="#60A5FA"
                                                   HorizontalAlignment="Center" />
                                        <TextBlock Text="Drag and drop any application binary or desktop shortcut"
                                                   FontSize="11.5"
                                                   Foreground="#55607A"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,3,0,0" />
                                    </StackPanel>
                                </Border>

                                <!-- Buttons -->
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <Button Style="{StaticResource StudioSecondaryButton}"
                                            Content="Browse Executable..."
                                            Height="34"
                                            Margin="0,0,0,8"
                                            Click="BrowseApp_Click" />
                                    <Button Style="{StaticResource StudioPrimaryButton}"
                                            Content="Scan Installed Apps"
                                            Height="34"
                                            Command="{Binding ScanInstalledAppsCommand}"
                                            IsEnabled="{Binding IsScanningApps, Converter={StaticResource InvBool}}" />
                                </StackPanel>
                            </Grid>

                            <!-- Scanned Apps List -->
                            <StackPanel Visibility="{Binding HasScannedApps, Converter={StaticResource BoolToVis}}" Margin="0,0,0,14">
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="220" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="DETECTED APPLICATIONS" FontSize="10.5" FontWeight="Bold" Foreground="#55607A" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="1"
                                             Text="{Binding ScannedSearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                             Height="28"
                                             Background="#0D1017"
                                             Foreground="#FFFFFF"
                                             BorderBrush="#1E2436"
                                             BorderThickness="1"
                                             Padding="8,4"
                                             FontSize="11.5"
                                             VerticalContentAlignment="Center" />
                                </Grid>

                                <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding FilteredScannedApps}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#0D1017" BorderBrush="#181D29" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,4">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="28" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Image Source="{Binding Icon}" Width="20" Height="20" HorizontalAlignment="Left" VerticalAlignment="Center" />
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                                                            <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold" Foreground="#FFFFFF" />
                                                            <TextBlock Text="{Binding DisplayProcessName}" FontSize="10.5" Foreground="#55607A" />
                                                        </StackPanel>
                                                        <Button Grid.Column="2"
                                                                Content="+ Block"
                                                                Height="24"
                                                                Padding="10,0"
                                                                FontSize="11"
                                                                FontWeight="SemiBold"
                                                                Background="#1B2232"
                                                                Foreground="#60A5FA"
                                                                BorderThickness="0"
                                                                Cursor="Hand"
                                                                Command="{Binding DataContext.AddBlockedAppCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding}">
                                                            <Button.Resources>
                                                                <Style TargetType="{x:Type Border}">
                                                                    <Setter Property="CornerRadius" Value="4" />
                                                                </Style>
                                                            </Button.Resources>
                                                        </Button>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>

                            <!-- Presets -->
                            <TextBlock Text="Popular Distraction Presets:" FontSize="11" Foreground="#55607A" Margin="0,0,0,8" />
                            <ItemsControl ItemsSource="{Binding DistractionPresets}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding Name, StringFormat='+ {0}'}"
                                                Height="26"
                                                Padding="10,0"
                                                Margin="0,0,6,6"
                                                FontSize="11"
                                                Background="#141824"
                                                Foreground="#CCD2E3"
                                                BorderBrush="#1E2536"
                                                BorderThickness="1"
                                                Cursor="Hand"
                                                Command="{Binding DataContext.AddBlockedAppCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}">
                                            <Button.Resources>
                                                <Style TargetType="{x:Type Border}">
                                                    <Setter Property="CornerRadius" Value="5" />
                                                </Style>
                                            </Button.Resources>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Blocked Apps List -->
                    <Border Style="{StaticResource StudioCard}">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="BLOCKED APPLICATIONS" FontSize="11" FontWeight="Bold" Foreground="#55607A" />
                                    <Border Margin="8,0,0,0" Padding="6,1" CornerRadius="5" Background="#1C2230">
                                        <TextBlock Text="{Binding BlockedApps.Count}" FontSize="10.5" FontWeight="Bold" Foreground="#60A5FA" />
                                    </Border>
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Style="{StaticResource StudioDangerButton}"
                                        Content="Clear All"
                                        Command="{Binding ClearAllBlockedAppsCommand}" />
                            </Grid>

                            <ItemsControl ItemsSource="{Binding BlockedApps}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#0D1017" BorderBrush="#1C2130" BorderThickness="1" CornerRadius="7" Padding="12,8" Margin="0,0,0,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="28" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Image Source="{Binding Icon}" Width="22" Height="22" HorizontalAlignment="Left" VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                                                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" />
                                                    <TextBlock Text="{Binding DisplayProcessName}" FontSize="10.5" Foreground="#55607A" />
                                                </StackPanel>
                                                <CheckBox Grid.Column="2"
                                                          Content="Blocked"
                                                          IsChecked="{Binding IsEnabled}"
                                                          Foreground="#CCD2E3"
                                                          FontSize="12"
                                                          VerticalAlignment="Center"
                                                          Margin="0,0,12,0"
                                                          Command="{Binding DataContext.ToggleBlockedAppStatusCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                          CommandParameter="{Binding}" />
                                                <Button Grid.Column="3"
                                                        Style="{StaticResource StudioDangerButton}"
                                                        Content="Remove"
                                                        Command="{Binding DataContext.RemoveBlockedAppCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ================= TAB 3: ANALYTICS & STREAKS ================= -->
            <ScrollViewer x:Name="AnalyticsTabView" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="32,24" MaxWidth="800">
                    <TextBlock Text="Analytics &amp; Streaks" FontSize="24" FontWeight="Bold" Foreground="#FFFFFF" />
                    <TextBlock Text="Productivity statistics, execution history, and streak consistency"
                               FontSize="13" Foreground="#636D88" Margin="0,3,0,20" />

                    <!-- Stat Cards Grid -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource StudioCard}" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="CURRENT STREAK" FontSize="10" FontWeight="Bold" Foreground="#F59E0B" />
                                <TextBlock Text="{Binding StreakCount, StringFormat='{}{0} Days'}" FontSize="24" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,4,0,0" />
                                <TextBlock Text="Active daily streak" FontSize="11" Foreground="#55607A" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource StudioCard}" Margin="4,0,4,0">
                            <StackPanel>
                                <TextBlock Text="LONGEST STREAK" FontSize="10" FontWeight="Bold" Foreground="#60A5FA" />
                                <TextBlock Text="{Binding LongestStreak, StringFormat='{}{0} Days'}" FontSize="24" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,4,0,0" />
                                <TextBlock Text="Personal best" FontSize="11" Foreground="#55607A" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource StudioCard}" Margin="8,0,0,0">
                            <StackPanel>
                                <TextBlock Text="COMPLETION RATE" FontSize="10" FontWeight="Bold" Foreground="#10B981" />
                                <TextBlock Text="{Binding CompletionRate, StringFormat='{}{0}%'}" FontSize="24" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,4,0,0" />
                                <TextBlock Text="{Binding TotalCompleted, StringFormat='{}{0} tasks completed'}" FontSize="11" Foreground="#55607A" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <!-- ================= TAB 4: ACCOUNT & CLOUD SYNC ================= -->
            <ScrollViewer x:Name="AccountTabView" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="32,24" MaxWidth="800">
                    <TextBlock Text="Account &amp; Cloud Sync" FontSize="24" FontWeight="Bold" Foreground="#FFFFFF" />
                    <TextBlock Text="Synchronize your tasks, streaks, and settings securely via private GitHub Gists"
                               FontSize="13" Foreground="#636D88" Margin="0,3,0,20" />

                    <Border Style="{StaticResource StudioCard}">
                        <StackPanel>
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="GITHUB ACCOUNT" FontSize="11" FontWeight="Bold" Foreground="#55607A" />
                                    <TextBlock Text="{Binding CloudSync.Username, FallbackValue='Not Connected'}"
                                               FontSize="15"
                                               FontWeight="Bold"
                                               Foreground="#FFFFFF"
                                               Margin="0,2,0,0" />
                                    <TextBlock Text="{Binding CloudSync.LastSyncText, StringFormat='Last synced: {0}'}"
                                               FontSize="11.5"
                                               Foreground="#8EA3D0"
                                               Margin="0,2,0,0" />
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Style="{StaticResource StudioPrimaryButton}"
                                        Content="Sync Now"
                                        Command="{Binding SyncNowCommand}" />
                            </Grid>

                            <Border Background="#0D1017" BorderBrush="#1C2130" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="Personal Access Token (Classic with gist scope):" FontSize="11.5" Foreground="#8EA3D0" Margin="0,0,0,6" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding GitHubTokenInput, UpdateSourceTrigger=PropertyChanged}"
                                                 Height="32"
                                                 Background="#131722"
                                                 Foreground="#FFFFFF"
                                                 BorderBrush="#202638"
                                                 BorderThickness="1"
                                                 Padding="8,4"
                                                 FontSize="12"
                                                 VerticalContentAlignment="Center" />
                                        <Button Grid.Column="2"
                                                Style="{StaticResource StudioSecondaryButton}"
                                                Content="Connect Token"
                                                Command="{Binding ConnectGitHubCommand}" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <CheckBox Content="Automatically sync tasks and streak after changes"
                                      IsChecked="{Binding SettingsVM.AutoSyncEnabled}"
                                      Foreground="#CCD2E3"
                                      FontSize="12.5" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ================= TAB 5: SETTINGS ================= -->
            <ScrollViewer x:Name="SettingsTabView" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="32,24" MaxWidth="800" DataContext="{Binding SettingsVM}">
                    <TextBlock Text="Application Settings" FontSize="24" FontWeight="Bold" Foreground="#FFFFFF" />
                    <TextBlock Text="Configure widget appearance, reminders, and system startup"
                               FontSize="13" Foreground="#636D88" Margin="0,3,0,20" />

                    <!-- Widget Appearance -->
                    <Border Style="{StaticResource StudioCard}">
                        <StackPanel>
                            <TextBlock Text="WIDGET APPEARANCE &amp; POSITION" FontSize="11" FontWeight="Bold" Foreground="#55607A" Margin="0,0,0,12" />

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Display Mode:" FontSize="12.5" Foreground="#8EA3D0" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <RadioButton Content="Float On Top" IsChecked="{Binding IsFloatOnTop}" Foreground="#CCD2E3" Margin="0,0,16,0" />
                                    <RadioButton Content="Pinned to Desktop (Wallpaper)" IsChecked="{Binding IsPinnedToDesktop}" Foreground="#CCD2E3" />
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Opacity:" FontSize="12.5" Foreground="#8EA3D0" VerticalAlignment="Center" />
                                <Slider Grid.Column="1" Minimum="0.3" Maximum="1.0" Value="{Binding WidgetOpacity}" TickFrequency="0.05" IsSnapToTickEnabled="True" VerticalAlignment="Center" />
                            </Grid>

                            <CheckBox Content="Show streak counter on desktop widget" IsChecked="{Binding ShowStreakOnWidget}" Foreground="#CCD2E3" FontSize="12.5" Margin="0,6,0,6" />
                            <CheckBox Content="Enable smooth UI micro-animations" IsChecked="{Binding EnableAnimations}" Foreground="#CCD2E3" FontSize="12.5" Margin="0,0,0,6" />
                            <CheckBox Content="Launch on Windows startup" IsChecked="{Binding LaunchOnStartup}" Foreground="#CCD2E3" FontSize="12.5" />
                        </StackPanel>
                    </Border>

                    <!-- Auto-Update & Version -->
                    <Border Style="{StaticResource StudioCard}">
                        <StackPanel>
                            <TextBlock Text="SYSTEM &amp; UPDATES" FontSize="11" FontWeight="Bold" Foreground="#55607A" Margin="0,0,0,8" />
                            <Grid Margin="0,4,0,8">
                                <TextBlock Text="Version:" FontSize="12.5" Foreground="#8EA3D0" />
                                <TextBlock Text="{Binding CurrentVersionText}" FontSize="12.5" FontWeight="Bold" Foreground="#60A5FA" HorizontalAlignment="Right" />
                            </Grid>
                            <Button Style="{StaticResource StudioSecondaryButton}"
                                    Content="Check For Updates"
                                    HorizontalAlignment="Left"
                                    Command="{Binding CheckForUpdatesCommand}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
